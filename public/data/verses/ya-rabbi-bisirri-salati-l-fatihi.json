{"id":"ya-rabbi-bisirri-salati-l-fatihi","slug":"ya-rabbi-bisirri-salati-l-fatihi","chapters":[{"id":"ya-rabbi-bisirri-salati-l-fatihi-ch1","n":1,"verseCount":13,"verses":[{"id":"ya-rabbi-bisirri-salati-l-fatihi-c1-v1","n":1,"ar":"يَا رَبِّ بِسِرِّ صَلَاةِ الْفَاتِحِ وَسِرِّ سِرِّهَا الْعَظِيمِ الْمَانِحِ","tr":"","sadr":"يَا رَبِّ بِسِرِّ صَلَاةِ الْفَاتِحِ","adj":"وَسِرِّ سِرِّهَا الْعَظِيمِ الْمَانِحِ"},{"id":"ya-rabbi-bisirri-salati-l-fatihi-c1-v2","n":2,"ar":"وَجَاهِ قَدْرِهَا وَحَقِّ قَدْرِهَا مِقْدَارِهَا الرَّفِيعِ مَا أَسْنَاهَا","tr":"","sadr":"وَجَاهِ قَدْرِهَا وَحَقِّ قَدْرِهَا","adj":"مِقْدَارِهَا الرَّفِيعِ مَا أَسْنَاهَا"},{"id":"ya-rabbi-bisirri-salati-l-fatihi-c1-v3","n":3,"ar":"لِكَوْنِهَا مُنِيرَةَ الْقُلُوبِ وَكَوْنِهَا غَافِرَةَ الذُّنُوبِ","tr":"","sadr":"لِكَوْنِهَا مُنِيرَةَ الْقُلُوبِ","adj":"وَكَوْنِهَا غَافِرَةَ الذُّنُوبِ"},{"id":"ya-rabbi-bisirri-salati-l-fatihi-c1-v4","n":4,"ar":"وَكَوْنِهَا جَالِبَةَ الْخُيُورِ وَكَوْنِهَا دَافِعَةَ الشُّرُورِ","tr":"","sadr":"وَكَوْنِهَا جَالِبَةَ الْخُيُورِ","adj":"وَكَوْنِهَا دَافِعَةَ الشُّرُورِ"},{"id":"ya-rabbi-bisirri-salati-l-fatihi-c1-v5","n":5,"ar":"فَوْزًا لِمَنْ لَازَمَهَا فِي الْعُمُرِ وَلَا يَلْقَ الدَّهْرَ كُلَّ الْعُسْرِ","tr":"","sadr":"فَوْزًا لِمَنْ لَازَمَهَا فِي الْعُمُرِ","adj":"وَلَا يَلْقَ الدَّهْرَ كُلَّ الْعُسْرِ"},{"id":"ya-rabbi-bisirri-salati-l-fatihi-c1-v6","n":6,"ar":"مَنْ يَكْتَفِي بِهَا عَنِ الْأَحْزَابِ يَنَالُ مَا يَرُومُ بِالْقَرِيبِ","tr":"","sadr":"مَنْ يَكْتَفِي بِهَا عَنِ الْأَحْزَابِ","adj":"يَنَالُ مَا يَرُومُ بِالْقَرِيبِ"},{"id":"ya-rabbi-bisirri-salati-l-fatihi-c1-v7","n":7,"ar":"أَدْعُوكَ يَا حَيُّ وَيَا قَيُّومُ دَمِّيرَكَ الْأَعْدَاءِ يَا عَظِيمُ","tr":"","sadr":"أَدْعُوكَ يَا حَيُّ وَيَا قَيُّومُ","adj":"دَمِّيرَكَ الْأَعْدَاءِ يَا عَظِيمُ"},{"id":"ya-rabbi-bisirri-salati-l-fatihi-c1-v8","n":8,"ar":"وَنَجِّنَا مِنْ شَرِّهِمْ وَكَيْدِهِمْ وَمَكْرِهِمْ وَظُلْمِهِمْ وَبُغْضِهِمْ","tr":"","sadr":"وَنَجِّنَا مِنْ شَرِّهِمْ وَكَيْدِهِمْ","adj":"وَمَكْرِهِمْ وَظُلْمِهِمْ وَبُغْضِهِمْ"},{"id":"ya-rabbi-bisirri-salati-l-fatihi-c1-v9","n":9,"ar":"وَأَنْ تُحِيلَ بَيْنَنَا وَبَيْنَمَا أَتَى إِلَيْنَا مِنْهُمُ وَأَلَمَّا","tr":"","sadr":"وَأَنْ تُحِيلَ بَيْنَنَا وَبَيْنَمَا","adj":"أَتَى إِلَيْنَا مِنْهُمُ وَأَلَمَّا"},{"id":"ya-rabbi-bisirri-salati-l-fatihi-c1-v10","n":10,"ar":"وَصَحِّحَنْ لَنَا بِهَا الْأَجْسَامَا وَطَوِّلَنْ لَنَا بِهَا الْأَعْوَامَا","tr":"","sadr":"وَصَحِّحَنْ لَنَا بِهَا الْأَجْسَامَا","adj":"وَطَوِّلَنْ لَنَا بِهَا الْأَعْوَامَا"},{"id":"ya-rabbi-bisirri-salati-l-fatihi-c1-v11","n":11,"ar":"وَاغْفِرْ لَنَا وَاغْفِرْ لِوَالِدِينَا وَلِشُيُوخِنَا الْمُجَاهِدِينَا","tr":"","sadr":"وَاغْفِرْ لَنَا وَاغْفِرْ لِوَالِدِينَا","adj":"وَلِشُيُوخِنَا الْمُجَاهِدِينَا"},{"id":"ya-rabbi-bisirri-salati-l-fatihi-c1-v12","n":12,"ar":"وَأَنْ تُمِيتَنَا عَلَى الصَّوَابِ فَاقْبَلْ لَنَا رَبِّ عَلَى التَّوَابِ","tr":"","sadr":"وَأَنْ تُمِيتَنَا عَلَى الصَّوَابِ","adj":"فَاقْبَلْ لَنَا رَبِّ عَلَى التَّوَابِ"},{"id":"ya-rabbi-bisirri-salati-l-fatihi-c1-v13","n":13,"ar":"آمِينَ آمِينَ بِلَا انْتِهَاءِ وَلَا تُخَيِّبْ رَبَّنَا رَجَائِي","tr":"","sadr":"آمِينَ آمِينَ بِلَا انْتِهَاءِ","adj":"وَلَا تُخَيِّبْ رَبَّنَا رَجَائِي"}]}]}
