{"id":"sallu-ya-ahla-l-kamali","slug":"sallu-ya-ahla-l-kamali","chapters":[{"id":"sallu-ya-ahla-l-kamali-ch1","n":1,"verseCount":42,"verses":[{"id":"sallu-ya-ahla-l-kamali-c1-v1","n":1,"ar":"صَلُّوا يَا أَهْلَ الْكَمَالِ عَ النَّبِي بَاهِي الْجَمَالِ","tr":"","sadr":"صَلُّوا يَا أَهْلَ الْكَمَالِ","adj":"عَ النَّبِي بَاهِي الْجَمَالِ"},{"id":"sallu-ya-ahla-l-kamali-c1-v2","n":2,"ar":"مَنْ حَوَى كُلَّ الْمَعَالِي قَدْرُهُ مَا زَالَ عَالِ","tr":"","sadr":"مَنْ حَوَى كُلَّ الْمَعَالِي","adj":"قَدْرُهُ مَا زَالَ عَالِ"},{"id":"sallu-ya-ahla-l-kamali-c1-v3","n":3,"ar":"قَدْرُهُ عَالِي مُفَخَّمْ دَائِمًا سَامِي مُكَرَّمْ","tr":"","sadr":"قَدْرُهُ عَالِي مُفَخَّمْ","adj":"دَائِمًا سَامِي مُكَرَّمْ"},{"id":"sallu-ya-ahla-l-kamali-c1-v4","n":4,"ar":"جَاهُهُ جَاهٌ مُعَظَّمْ وَجْهُهُ فَاقَ الْهِلَالِ","tr":"","sadr":"جَاهُهُ جَاهٌ مُعَظَّمْ","adj":"وَجْهُهُ فَاقَ الْهِلَالِ"},{"id":"sallu-ya-ahla-l-kamali-c1-v5","n":5,"ar":"وَجْهُهُ بَدْرٌ مُنَوَّرْ جَلَّ مَنْ أَنْشَا وَصَوَّرْ","tr":"","sadr":"وَجْهُهُ بَدْرٌ مُنَوَّرْ","adj":"جَلَّ مَنْ أَنْشَا وَصَوَّرْ"},{"id":"sallu-ya-ahla-l-kamali-c1-v6","n":6,"ar":"رَأْسُهُ مِسْكٌ وَعَنْبَرْ شَعْرُهُ دَاجِي اللَّيَالِ","tr":"","sadr":"رَأْسُهُ مِسْكٌ وَعَنْبَرْ","adj":"شَعْرُهُ دَاجِي اللَّيَالِ"},{"id":"sallu-ya-ahla-l-kamali-c1-v7","n":7,"ar":"وَالْجَبِينُ الْبَرْقُ يَلْمَعْ خَدُّهُ بِالنُّورِ يَسْطَعْ","tr":"","sadr":"وَالْجَبِينُ الْبَرْقُ يَلْمَعْ","adj":"خَدُّهُ بِالنُّورِ يَسْطَعْ"},{"id":"sallu-ya-ahla-l-kamali-c1-v8","n":8,"ar":"خَدُّهُ لِلصُّبْحِ مَطْلَعْ عَيْنُهُ تَسْبِي الْغَزَالِ","tr":"","sadr":"خَدُّهُ لِلصُّبْحِ مَطْلَعْ","adj":"عَيْنُهُ تَسْبِي الْغَزَالِ"},{"id":"sallu-ya-ahla-l-kamali-c1-v9","n":9,"ar":"عَيْنُهُ سَوْدَا كَحِيلَهْ طَلْعَةُ الْهَادِي جَمِيلَهْ","tr":"","sadr":"عَيْنُهُ سَوْدَا كَحِيلَهْ","adj":"طَلْعَةُ الْهَادِي جَمِيلَهْ"},{"id":"sallu-ya-ahla-l-kamali-c1-v10","n":10,"ar":"بَهْجَةُ السَّامِي جَلِيلَهْ قَدُّهُ فَاقَ الْعَوَالِ","tr":"","sadr":"بَهْجَةُ السَّامِي جَلِيلَهْ","adj":"قَدُّهُ فَاقَ الْعَوَالِ"},{"id":"sallu-ya-ahla-l-kamali-c1-v11","n":11,"ar":"ثَغْرُهُ مِسْكٌ مُعَطَّرْ رِيقُهُ سُكَّرْ مُكَرَّرْ","tr":"","sadr":"ثَغْرُهُ مِسْكٌ مُعَطَّرْ","adj":"رِيقُهُ سُكَّرْ مُكَرَّرْ"},{"id":"sallu-ya-ahla-l-kamali-c1-v12","n":12,"ar":"نُطْقُهُ حَقٌّ مُقَرَّرْ قَوْلُهُ أَحْلَى الْمَقَالِ","tr":"","sadr":"نُطْقُهُ حَقٌّ مُقَرَّرْ","adj":"قَوْلُهُ أَحْلَى الْمَقَالِ"},{"id":"sallu-ya-ahla-l-kamali-c1-v13","n":13,"ar":"وَالْمَبَاسِمْ سُكَرِيَّهْ وَالثَّنَايَا لُؤْلُؤِيَّهْ","tr":"","sadr":"وَالْمَبَاسِمْ سُكَرِيَّهْ","adj":"وَالثَّنَايَا لُؤْلُؤِيَّهْ"},{"id":"sallu-ya-ahla-l-kamali-c1-v14","n":14,"ar":"وَالرَّوَائِحْ عَنْبَرِيَّهْ هَيَّجَتْ فِكْرِي وَبَالِ","tr":"","sadr":"وَالرَّوَائِحْ عَنْبَرِيَّهْ","adj":"هَيَّجَتْ فِكْرِي وَبَالِ"},{"id":"sallu-ya-ahla-l-kamali-c1-v15","n":15,"ar":"وَالْبَهَا لِلذَّاتِ كَلَّلْ فِي سَنَاءٍ قَدْ تَكَمَّلْ","tr":"","sadr":"وَالْبَهَا لِلذَّاتِ كَلَّلْ","adj":"فِي سَنَاءٍ قَدْ تَكَمَّلْ"},{"id":"sallu-ya-ahla-l-kamali-c1-v16","n":16,"ar":"وَازْدِهَاءٍ قَدْ تَزَمَّلْ بِالْمَحَاسِنْ وَالْجَمَالِ","tr":"","sadr":"وَازْدِهَاءٍ قَدْ تَزَمَّلْ","adj":"بِالْمَحَاسِنْ وَالْجَمَالِ"},{"id":"sallu-ya-ahla-l-kamali-c1-v17","n":17,"ar":"صَدْرُهُ كَنْزُ الْمَعَارِفْ وَالْمَعَانِي وَاللَّطَائِفْ","tr":"","sadr":"صَدْرُهُ كَنْزُ الْمَعَارِفْ","adj":"وَالْمَعَانِي وَاللَّطَائِفْ"},{"id":"sallu-ya-ahla-l-kamali-c1-v18","n":18,"ar":"جَاهُهُ لِلْهَمِّ صَارِفْ دَأْبُهُ بَذْلُ النَّوَالِ","tr":"","sadr":"جَاهُهُ لِلْهَمِّ صَارِفْ","adj":"دَأْبُهُ بَذْلُ النَّوَالِ"},{"id":"sallu-ya-ahla-l-kamali-c1-v19","n":19,"ar":"كَفُّهُ بَحْرُ الْمَكَارِمْ وَالْعَطَايَا وَالْغَنَائِمْ","tr":"","sadr":"كَفُّهُ بَحْرُ الْمَكَارِمْ","adj":"وَالْعَطَايَا وَالْغَنَائِمْ"},{"id":"sallu-ya-ahla-l-kamali-c1-v20","n":20,"ar":"جُودُهُ لِلْخَلْقِ عَامِمْ فَضْلُهُ يَأْبَى الْمِثَالِ","tr":"","sadr":"جُودُهُ لِلْخَلْقِ عَامِمْ","adj":"فَضْلُهُ يَأْبَى الْمِثَالِ"},{"id":"sallu-ya-ahla-l-kamali-c1-v21","n":21,"ar":"بَطْنُهُ عِلْمٌ وَحِكْمَهْ فَهْمُهُ سِرٌّ وَنِعْمَهْ","tr":"","sadr":"بَطْنُهُ عِلْمٌ وَحِكْمَهْ","adj":"فَهْمُهُ سِرٌّ وَنِعْمَهْ"},{"id":"sallu-ya-ahla-l-kamali-c1-v22","n":22,"ar":"قَلْبُهُ نُورٌ وَرَحْمَهْ جَلَّ بَارٍ ذُو جَلَالِ","tr":"","sadr":"قَلْبُهُ نُورٌ وَرَحْمَهْ","adj":"جَلَّ بَارٍ ذُو جَلَالِ"},{"id":"sallu-ya-ahla-l-kamali-c1-v23","n":23,"ar":"مَشْيُهُ فِي الصَّخْرِ عَلَّمْ وَالْحَجَرْ صَلَّى وَسَلَّمْ","tr":"","sadr":"مَشْيُهُ فِي الصَّخْرِ عَلَّمْ","adj":"وَالْحَجَرْ صَلَّى وَسَلَّمْ"},{"id":"sallu-ya-ahla-l-kamali-c1-v24","n":24,"ar":"بِبِرَاهِينَ تُسَلَّمْ وَعَلَيْهِ الظِّلُّ مَالِ","tr":"","sadr":"بِبِرَاهِينَ تُسَلَّمْ","adj":"وَعَلَيْهِ الظِّلُّ مَالِ"},{"id":"sallu-ya-ahla-l-kamali-c1-v25","n":25,"ar":"كَمْ مُحِبٍّ قَدْ تَتَيَّمْ وَمَشُوقٍ قَدْ تَرَنَّمْ","tr":"","sadr":"كَمْ مُحِبٍّ قَدْ تَتَيَّمْ","adj":"وَمَشُوقٍ قَدْ تَرَنَّمْ"},{"id":"sallu-ya-ahla-l-kamali-c1-v26","n":26,"ar":"وَعَذُولٍ قَدْ تَأَيَّمْ وَاكْتَسَى ثَوْبَ النَّكَالِ","tr":"","sadr":"وَعَذُولٍ قَدْ تَأَيَّمْ","adj":"وَاكْتَسَى ثَوْبَ النَّكَالِ"},{"id":"sallu-ya-ahla-l-kamali-c1-v27","n":27,"ar":"حُبُّهُ فِي الْقَلْبِ سَاكِنْ حُسْنُهُ لِلْعَقْلِ فَاتِنْ","tr":"","sadr":"حُبُّهُ فِي الْقَلْبِ سَاكِنْ","adj":"حُسْنُهُ لِلْعَقْلِ فَاتِنْ"},{"id":"sallu-ya-ahla-l-kamali-c1-v28","n":28,"ar":"مَدْحُهُ لِلْقَوْلِ زَائِنْ كُنْهُهُ غَالٍ وَعَالِ","tr":"","sadr":"مَدْحُهُ لِلْقَوْلِ زَائِنْ","adj":"كُنْهُهُ غَالٍ وَعَالِ"},{"id":"sallu-ya-ahla-l-kamali-c1-v29","n":29,"ar":"وَالْمَعَالِي هَيَّجَتْنِي وَالْمَعَانِي أَدْهَشَتْنِي","tr":"","sadr":"وَالْمَعَالِي هَيَّجَتْنِي","adj":"وَالْمَعَانِي أَدْهَشَتْنِي"},{"id":"sallu-ya-ahla-l-kamali-c1-v30","n":30,"ar":"وَالْمَبَانِي حَيَّرَتْنِي مِنْهُ حَالِي غَيْرُ حَالِ","tr":"","sadr":"وَالْمَبَانِي حَيَّرَتْنِي","adj":"مِنْهُ حَالِي غَيْرُ حَالِ"},{"id":"sallu-ya-ahla-l-kamali-c1-v31","n":31,"ar":"يَا إِمَامَ الْأَنْبِيَاءِ يَا مَلَاذَ الْأَنْقِيَاءِ","tr":"","sadr":"يَا إِمَامَ الْأَنْبِيَاءِ","adj":"يَا مَلَاذَ الْأَنْقِيَاءِ"},{"id":"sallu-ya-ahla-l-kamali-c1-v32","n":32,"ar":"يَا سِرَاجَ الْأَوْلِيَاءِ دَامَ لِي فِيكَ اتِّصَالِ","tr":"","sadr":"يَا سِرَاجَ الْأَوْلِيَاءِ","adj":"دَامَ لِي فِيكَ اتِّصَالِ"},{"id":"sallu-ya-ahla-l-kamali-c1-v33","n":33,"ar":"يَا غِيَاثِي مِنْ عِدَاتِي يَا مَلَاذِي فِي حَيَاتِي","tr":"","sadr":"يَا غِيَاثِي مِنْ عِدَاتِي","adj":"يَا مَلَاذِي فِي حَيَاتِي"},{"id":"sallu-ya-ahla-l-kamali-c1-v34","n":34,"ar":"يَا أَنِيسِي فِي مَمَاتِي رَاعِ حَالِي بِالْجَمَالِ","tr":"","sadr":"يَا أَنِيسِي فِي مَمَاتِي","adj":"رَاعِ حَالِي بِالْجَمَالِ"},{"id":"sallu-ya-ahla-l-kamali-c1-v35","n":35,"ar":"يَا مُحَمَّدْ يَا حَبِيبِي يَا مُحَمَّدْ كُنْ طَبِيبِي","tr":"","sadr":"يَا مُحَمَّدْ يَا حَبِيبِي","adj":"يَا مُحَمَّدْ كُنْ طَبِيبِي"},{"id":"sallu-ya-ahla-l-kamali-c1-v36","n":36,"ar":"وَأَجِرْنِي مِن لَهِيبِ إِنَّ أَوْزَارِي ثِقَالِ","tr":"","sadr":"وَأَجِرْنِي مِن لَهِيبِ","adj":"إِنَّ أَوْزَارِي ثِقَالِ"},{"id":"sallu-ya-ahla-l-kamali-c1-v37","n":37,"ar":"كُنْ غَدًا يَوْمَ الْقِصَاصِ يَوْمَ يُؤْخَذْ بِالنَّوَاصِي","tr":"","sadr":"كُنْ غَدًا يَوْمَ الْقِصَاصِ","adj":"يَوْمَ يُؤْخَذْ بِالنَّوَاصِي"},{"id":"sallu-ya-ahla-l-kamali-c1-v38","n":38,"ar":"سَاعِيًا لِي فِي خَلَاصِي مِنْ حِسَابٍ مَعْ سُؤَالِ","tr":"","sadr":"سَاعِيًا لِي فِي خَلَاصِي","adj":"مِنْ حِسَابٍ مَعْ سُؤَالِ"},{"id":"sallu-ya-ahla-l-kamali-c1-v39","n":39,"ar":"فَالْمُنَاوِي فِي بَلِيَّهْ وَسَجَايَاكَ عَلِيَّهْ","tr":"","sadr":"فَالْمُنَاوِي فِي بَلِيَّهْ","adj":"وَسَجَايَاكَ عَلِيَّهْ"},{"id":"sallu-ya-ahla-l-kamali-c1-v40","n":40,"ar":"كُنْ لَهُ خَيْرَ الْبَرِيَّهْ مُدْرِكًا يَا زَيْنَ وَالِ","tr":"","sadr":"كُنْ لَهُ خَيْرَ الْبَرِيَّهْ","adj":"مُدْرِكًا يَا زَيْنَ وَالِ"},{"id":"sallu-ya-ahla-l-kamali-c1-v41","n":41,"ar":"وَصَلَاةً مَعْ سَلَامِ عَ النَّبِي خَيْرِ الْأَنَامِ","tr":"","sadr":"وَصَلَاةً مَعْ سَلَامِ","adj":"عَ النَّبِي خَيْرِ الْأَنَامِ"},{"id":"sallu-ya-ahla-l-kamali-c1-v42","n":42,"ar":"وَعَلَى صَحْبٍ كِرَامِ مَعَ آلٍ خَيْرِ آلِ","tr":"","sadr":"وَعَلَى صَحْبٍ كِرَامِ","adj":"مَعَ آلٍ خَيْرِ آلِ"}]}]}
