{"id":"cheikh-ahmed-tidiane-sy-nahnu-awladu-tijani","slug":"cheikh-ahmed-tidiane-sy-nahnu-awladu-tijani","chapters":[{"id":"cheikh-ahmed-tidiane-sy-nahnu-awladu-tijani-ch1","n":1,"verseCount":25,"verses":[{"id":"cheikh-ahmed-tidiane-sy-nahnu-awladu-tijani-c1-v1","n":1,"ar":"نَحْنُ أَوْلَادُ التِّجَانِي مِنْ أُبُوَّاتِ الْمَعَانِي","tr":"","sadr":"نَحْنُ أَوْلَادُ التِّجَانِي","adj":"مِنْ أُبُوَّاتِ الْمَعَانِي"},{"id":"cheikh-ahmed-tidiane-sy-nahnu-awladu-tijani-c1-v2","n":2,"ar":"وَلَنَا مِنْهُ نَصِيبٌ فَوْقَ غَايَاتِ الْأَمَانِي","tr":"","sadr":"وَلَنَا مِنْهُ نَصِيبٌ","adj":"فَوْقَ غَايَاتِ الْأَمَانِي"},{"id":"cheikh-ahmed-tidiane-sy-nahnu-awladu-tijani-c1-v3","n":3,"ar":"جَمَعَ الْخَيْرَاتِ فِينَا اِحْتِفَاظًا بِالْمَبَانِي","tr":"","sadr":"جَمَعَ الْخَيْرَاتِ فِينَا","adj":"اِحْتِفَاظًا بِالْمَبَانِي"},{"id":"cheikh-ahmed-tidiane-sy-nahnu-awladu-tijani-c1-v4","n":4,"ar":"قد دَعَانَا فَأَجَبْنَا وَهْوَ مِقْبَاسُ الزَّمَانِ","tr":"","sadr":"قد دَعَانَا فَأَجَبْنَا","adj":"وَهْوَ مِقْبَاسُ الزَّمَانِ"},{"id":"cheikh-ahmed-tidiane-sy-nahnu-awladu-tijani-c1-v5","n":5,"ar":"بَلْ هَدَانَا فَاهْتَدَيْنَا مَا لَهُ فِي الْفَتْحِ ثَانِ","tr":"","sadr":"بَلْ هَدَانَا فَاهْتَدَيْنَا","adj":"مَا لَهُ فِي الْفَتْحِ ثَانِ"},{"id":"cheikh-ahmed-tidiane-sy-nahnu-awladu-tijani-c1-v6","n":6,"ar":"كُلُّ مَنْ لَاقَاهُ يَدْرِي أَنَّهُ رُوحُ التَّدَانِي","tr":"","sadr":"كُلُّ مَنْ لَاقَاهُ يَدْرِي","adj":"أَنَّهُ رُوحُ التَّدَانِي"},{"id":"cheikh-ahmed-tidiane-sy-nahnu-awladu-tijani-c1-v7","n":7,"ar":"طَاعَةٌ فِي طَاقَةٍ أَوْ صَوْلَةٌ ضِدَّ التَّوَانِي","tr":"","sadr":"طَاعَةٌ فِي طَاقَةٍ أَوْ","adj":"صَوْلَةٌ ضِدَّ التَّوَانِي"},{"id":"cheikh-ahmed-tidiane-sy-nahnu-awladu-tijani-c1-v8","n":8,"ar":"إِنَّ رَبِّي قَدْ حَبَانِي أَنْ أُسَمَّى بِالتِّجَانِي","tr":"","sadr":"إِنَّ رَبِّي قَدْ حَبَانِي","adj":"أَنْ أُسَمَّى بِالتِّجَانِي"},{"id":"cheikh-ahmed-tidiane-sy-nahnu-awladu-tijani-c1-v9","n":9,"ar":"فَأَضَاءَ الْقَلْبَ شَيْءٌ قَادَهُ نَحْوَ الْمَغَانِي","tr":"","sadr":"فَأَضَاءَ الْقَلْبَ شَيْءٌ","adj":"قَادَهُ نَحْوَ الْمَغَانِي"},{"id":"cheikh-ahmed-tidiane-sy-nahnu-awladu-tijani-c1-v10","n":10,"ar":"يَا أَبَا الْعَبَّاسِ يَا مَنْ كَنْزُهُ كَنْزُ الْأَمَانِي","tr":"","sadr":"يَا أَبَا الْعَبَّاسِ يَا مَنْ","adj":"كَنْزُهُ كَنْزُ الْأَمَانِي"},{"id":"cheikh-ahmed-tidiane-sy-nahnu-awladu-tijani-c1-v11","n":11,"ar":"جَاءَنَا خَيْرٌ عَمِيمٌ هِبَةً دُونَ امْتِحَانِ","tr":"","sadr":"جَاءَنَا خَيْرٌ عَمِيمٌ","adj":"هِبَةً دُونَ امْتِحَانِ"},{"id":"cheikh-ahmed-tidiane-sy-nahnu-awladu-tijani-c1-v12","n":12,"ar":"أَنْتَ كَالْغَيْثِ إِذَا مَا صَبَّ يَجْرِي بِامْتِنَانِ","tr":"","sadr":"أَنْتَ كَالْغَيْثِ إِذَا مَا","adj":"صَبَّ يَجْرِي بِامْتِنَانِ"},{"id":"cheikh-ahmed-tidiane-sy-nahnu-awladu-tijani-c1-v13","n":13,"ar":"مَلَأَ الْوِدْيَانَ حَتَّى أَصْبَحَتْ زِيَّ الْجِنَانِ","tr":"","sadr":"مَلَأَ الْوِدْيَانَ حَتَّى","adj":"أَصْبَحَتْ زِيَّ الْجِنَانِ"},{"id":"cheikh-ahmed-tidiane-sy-nahnu-awladu-tijani-c1-v14","n":14,"ar":"لَمْ يُغَادِرْ أَيَّ شَيْءٍ مِنْ بُحُورٍ وَأَوَانِ","tr":"","sadr":"لَمْ يُغَادِرْ أَيَّ شَيْءٍ","adj":"مِنْ بُحُورٍ وَأَوَانِ"},{"id":"cheikh-ahmed-tidiane-sy-nahnu-awladu-tijani-c1-v15","n":15,"ar":"سَلَبَتْ عَقْلِيَ مِنْهَا زَهَرَاتٌ بِحَنَانِ","tr":"","sadr":"سَلَبَتْ عَقْلِيَ مِنْهَا","adj":"زَهَرَاتٌ بِحَنَانِ"},{"id":"cheikh-ahmed-tidiane-sy-nahnu-awladu-tijani-c1-v16","n":16,"ar":"نَفَحَاتُ الْوَرْدِ شَاقَتْ عَنْدَلِيبًا بِأَغَانِ","tr":"","sadr":"نَفَحَاتُ الْوَرْدِ شَاقَتْ","adj":"عَنْدَلِيبًا بِأَغَانِ"},{"id":"cheikh-ahmed-tidiane-sy-nahnu-awladu-tijani-c1-v17","n":17,"ar":"وَبِطِيبٍ مِنْ هَوَاءٍ يَزْدَرِي مِسْكَ الْحِسَانِ","tr":"","sadr":"وَبِطِيبٍ مِنْ هَوَاءٍ","adj":"يَزْدَرِي مِسْكَ الْحِسَانِ"},{"id":"cheikh-ahmed-tidiane-sy-nahnu-awladu-tijani-c1-v18","n":18,"ar":"رِيحُهُ رِيحُ الْخُزَامَى سَلْهُ عَنْ أَهْلِ الْبَيَانِ","tr":"","sadr":"رِيحُهُ رِيحُ الْخُزَامَى","adj":"سَلْهُ عَنْ أَهْلِ الْبَيَانِ"},{"id":"cheikh-ahmed-tidiane-sy-nahnu-awladu-tijani-c1-v19","n":19,"ar":"أَعْجَزَ الْحَالُ رِجَالَ الْحَالِ فِي كُلِّ لِسَانِ","tr":"","sadr":"أَعْجَزَ الْحَالُ رِجَالَ","adj":"الْحَالِ فِي كُلِّ لِسَانِ"},{"id":"cheikh-ahmed-tidiane-sy-nahnu-awladu-tijani-c1-v20","n":20,"ar":"أَنْعَمَ اللَّهُ عَلَى مَنْ خَتْمُهُ جِدُّ التَّهَانِي","tr":"","sadr":"أَنْعَمَ اللَّهُ عَلَى مَنْ","adj":"خَتْمُهُ جِدُّ التَّهَانِي"},{"id":"cheikh-ahmed-tidiane-sy-nahnu-awladu-tijani-c1-v21","n":21,"ar":"هَلْ يَرَى الإِكْسِيرُ مِنْهُ غَيْرَ ذِي خَتْمٍ وَشَانِ","tr":"","sadr":"هَلْ يَرَى الإِكْسِيرُ مِنْهُ","adj":"غَيْرَ ذِي خَتْمٍ وَشَانِ"},{"id":"cheikh-ahmed-tidiane-sy-nahnu-awladu-tijani-c1-v22","n":22,"ar":"جَدُّهُ الْفَرْدُ طَبِيبُ النْـ ـنَفْسِ مِرْآةُ الْجَنَانِ","tr":"","sadr":"جَدُّهُ الْفَرْدُ طَبِيبُ النْـ","adj":"ـنَفْسِ مِرْآةُ الْجَنَانِ"},{"id":"cheikh-ahmed-tidiane-sy-nahnu-awladu-tijani-c1-v23","n":23,"ar":"صَلِّ يَا رَبِّ عَلَيْهِ وَعَلَى أَهْلِ التَّفَانِي","tr":"","sadr":"صَلِّ يَا رَبِّ عَلَيْهِ","adj":"وَعَلَى أَهْلِ التَّفَانِي"},{"id":"cheikh-ahmed-tidiane-sy-nahnu-awladu-tijani-c1-v24","n":24,"ar":"آلِهِ الْغُرِّ مَعَ الْأَصْـ ـحَابِ قَامُوا لِلطِّعَانِ","tr":"","sadr":"آلِهِ الْغُرِّ مَعَ الْأَصْـ","adj":"ـحَابِ قَامُوا لِلطِّعَانِ"},{"id":"cheikh-ahmed-tidiane-sy-nahnu-awladu-tijani-c1-v25","n":25,"ar":"فِي سَبِيلِ اللَّهِ حَتَّى قَدَّسُوا كُلَّ مَكَانِ","tr":"","sadr":"فِي سَبِيلِ اللَّهِ حَتَّى","adj":"قَدَّسُوا كُلَّ مَكَانِ"}]}]}
