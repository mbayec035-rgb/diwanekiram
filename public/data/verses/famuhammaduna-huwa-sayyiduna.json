{"id":"famuhammaduna-huwa-sayyiduna","slug":"famuhammaduna-huwa-sayyiduna","chapters":[{"id":"famuhammaduna-huwa-sayyiduna-ch1","n":1,"verseCount":22,"verses":[{"id":"famuhammaduna-huwa-sayyiduna-c1-v1","n":1,"ar":"يَا مَنْ يَنْحُوا حَقًّا أَمَلُ وَلَقَدْ نُفِيَ الْمِثْلُ الْمَثَلُ","tr":"","sadr":"يَا مَنْ يَنْحُوا حَقًّا أَمَلُ","adj":"وَلَقَدْ نُفِيَ الْمِثْلُ الْمَثَلُ"},{"id":"famuhammaduna-huwa-sayyiduna-c1-v2","n":2,"ar":"هَذَا عَبْدٌ يَرْجُوا مِنَنًا وَبِهِ أَسَفٌ يَنْمُوا وَجَلُ","tr":"","sadr":"هَذَا عَبْدٌ يَرْجُوا مِنَنًا","adj":"وَبِهِ أَسَفٌ يَنْمُوا وَجَلُ"},{"id":"famuhammaduna-huwa-sayyiduna-c1-v3","n":3,"ar":"أَنْتَ اللهُ الْمَوْلَى الْكَرَمُ الْـ ـأَحَدُ الصَّمَدُ الْفَرْدُ الْأَوَّلُ","tr":"","sadr":"أَنْتَ اللهُ الْمَوْلَى الْكَرَمُ الْـ","adj":"ـأَحَدُ الصَّمَدُ الْفَرْدُ الْأَوَّلُ"},{"id":"famuhammaduna-huwa-sayyiduna-c1-v4","n":4,"ar":"هَذَا عَبْدٌ يَشْكُوا أَرَبًا وَلَكَمْ قُضِيَ الْمُلْهِي الشُّغَلُ","tr":"","sadr":"هَذَا عَبْدٌ يَشْكُوا أَرَبًا","adj":"وَلَكَمْ قُضِيَ الْمُلْهِي الشُّغَلُ"},{"id":"famuhammaduna-huwa-sayyiduna-c1-v5","n":5,"ar":"فَرِّجْ عَنِّي ضَيْقًا حَرَجًا وَلَقَدْ مَرِجَتْ قَلْبِي الْعِلَلُ","tr":"","sadr":"فَرِّجْ عَنِّي ضَيْقًا حَرَجًا","adj":"وَلَقَدْ مَرِجَتْ قَلْبِي الْعِلَلُ"},{"id":"famuhammaduna-huwa-sayyiduna-c1-v6","n":6,"ar":"جَانَا دَهْرٌ هَالَ النُّبَلَا وَبِهِ الْكُرَمَا غَابُوا انْفَصَلُوا","tr":"","sadr":"جَانَا دَهْرٌ هَالَ النُّبَلَا","adj":"وَبِهِ الْكُرَمَا غَابُوا انْفَصَلُوا"},{"id":"famuhammaduna-huwa-sayyiduna-c1-v7","n":7,"ar":"أنْتَ الْحِصْنُ الْوَاقِي كَرَمًا وَبِحُرْمَةِ مَنْ تُعْطَى الْمِلَلُ","tr":"","sadr":"أنْتَ الْحِصْنُ الْوَاقِي كَرَمًا","adj":"وَبِحُرْمَةِ مَنْ تُعْطَى الْمِلَلُ"},{"id":"famuhammaduna-huwa-sayyiduna-c1-v8","n":8,"ar":"فَمُحَمَّدُنَا هُوَ سَيِّدُنَـا هُوَ أَجْمَلُ مَنْ تَرْنُوا الْمُقَلُ","tr":"","sadr":"فَمُحَمَّدُنَا هُوَ سَيِّدُنَـا","adj":"هُوَ أَجْمَلُ مَنْ تَرْنُوا الْمُقَلُ"},{"id":"famuhammaduna-huwa-sayyiduna-c1-v9","n":9,"ar":"نُورُ الْخَلْقِ الْمُسْرَى عَلَنًا وَرَوَى عَجَبًا أَيْنَ الرُّسُلُ","tr":"","sadr":"نُورُ الْخَلْقِ الْمُسْرَى عَلَنًا","adj":"وَرَوَى عَجَبًا أَيْنَ الرُّسُلُ"},{"id":"famuhammaduna-huwa-sayyiduna-c1-v10","n":10,"ar":"حَالِي رَبِّي لَمْ يَخْفَ عَلِي وَبِيَ الْوَهْنُ الْعَجْزُ الْكَسَلُ","tr":"","sadr":"حَالِي رَبِّي لَمْ يَخْفَ عَلِي","adj":"وَبِيَ الْوَهْنُ الْعَجْزُ الْكَسَلُ"},{"id":"famuhammaduna-huwa-sayyiduna-c1-v11","n":11,"ar":"فَاكْشِفْ عَنِّي ضُرًّا وَأَسًى وَكَذَا مِحَنٌ غَمٌّ غِلَلُ","tr":"","sadr":"فَاكْشِفْ عَنِّي ضُرًّا وَأَسًى","adj":"وَكَذَا مِحَنٌ غَمٌّ غِلَلُ"},{"id":"famuhammaduna-huwa-sayyiduna-c1-v12","n":12,"ar":"سَهِّلْ رَبِّي قَصْدًا لِجَنَا بِكَ تَقْصُدُكُمْ حَقًّا سُبُلُ","tr":"","sadr":"سَهِّلْ رَبِّي قَصْدًا لِجَنَا","adj":"بِكَ تَقْصُدُكُمْ حَقًّا سُبُلُ"},{"id":"famuhammaduna-huwa-sayyiduna-c1-v13","n":13,"ar":"أَسْبِلْ سِتْرًا فَضْلًا نِعْمًا وَلَكُمْ غُرَفٌ مَعَهَا الْحُلَلُ","tr":"","sadr":"أَسْبِلْ سِتْرًا فَضْلًا نِعْمًا","adj":"وَلَكُمْ غُرَفٌ مَعَهَا الْحُلَلُ"},{"id":"famuhammaduna-huwa-sayyiduna-c1-v14","n":14,"ar":"إِنِّي أَرْجُو مَوْتًا كَرَمًا بِطَرِيقَتِنَا نِعْمَ الْعَمَلُ","tr":"","sadr":"إِنِّي أَرْجُو مَوْتًا كَرَمًا","adj":"بِطَرِيقَتِنَا نِعْمَ الْعَمَلُ"},{"id":"famuhammaduna-huwa-sayyiduna-c1-v15","n":15,"ar":"هِيَ أُسْلُوبٌ مِنْ ذِي رُتَبٍ وَلِمَنْ دَخَلُوا فَوْزٌ نَفَلُ","tr":"","sadr":"هِيَ أُسْلُوبٌ مِنْ ذِي رُتَبٍ","adj":"وَلِمَنْ دَخَلُوا فَوْزٌ نَفَلُ"},{"id":"famuhammaduna-huwa-sayyiduna-c1-v16","n":16,"ar":"أَعْنِي شَيْخًا قُطْبًا وَزَرًا وَصَحَابَتُهُ حَقًّا وَصَلُوا","tr":"","sadr":"أَعْنِي شَيْخًا قُطْبًا وَزَرًا","adj":"وَصَحَابَتُهُ حَقًّا وَصَلُوا"},{"id":"famuhammaduna-huwa-sayyiduna-c1-v17","n":17,"ar":"أَعْنِي شَيْخًا قُطْبًا وَوِرَا ثَتُهُ سَبَقَتْ سَلْ مَنْ عَقَلُوا","tr":"","sadr":"أَعْنِي شَيْخًا قُطْبًا وَوِرَا","adj":"ثَتُهُ سَبَقَتْ سَلْ مَنْ عَقَلُوا"},{"id":"famuhammaduna-huwa-sayyiduna-c1-v18","n":18,"ar":"يَا ذَا الْبَيْتِ الْمَبْنِي لِطَوَا ئِفِهِ خَبَبٌ سَعْيٌ رَمَلُ","tr":"","sadr":"يَا ذَا الْبَيْتِ الْمَبْنِي لِطَوَا","adj":"ئِفِهِ خَبَبٌ سَعْيٌ رَمَلُ"},{"id":"famuhammaduna-huwa-sayyiduna-c1-v19","n":19,"ar":"هَذَا عَبْدٌ يَأْوِي كَنَفًا وَحَوَائِجُهُ شَتَّى جُمَلُ","tr":"","sadr":"هَذَا عَبْدٌ يَأْوِي كَنَفًا","adj":"وَحَوَائِجُهُ شَتَّى جُمَلُ"},{"id":"famuhammaduna-huwa-sayyiduna-c1-v20","n":20,"ar":"عَجِّلْ عَجِّلْ أَتْمِمْ غَرَضًا لِعُبَيْدِكَ لاَ رُدَّ اْلأَمَلُ","tr":"","sadr":"عَجِّلْ عَجِّلْ أَتْمِمْ غَرَضًا","adj":"لِعُبَيْدِكَ لاَ رُدَّ اْلأَمَلُ"},{"id":"famuhammaduna-huwa-sayyiduna-c1-v21","n":21,"ar":"صَلَّى رَبِّي أَزْكَى الصَّلَوَا تِ عَلَى الْهَادِي فِيهِ الْأَزَلُ","tr":"","sadr":"صَلَّى رَبِّي أَزْكَى الصَّلَوَا","adj":"تِ عَلَى الْهَادِي فِيهِ الْأَزَلُ"},{"id":"famuhammaduna-huwa-sayyiduna-c1-v22","n":22,"ar":"ثُمَّ اْلآلِ الصَّحْبِ الْكُرَمَا وَهُمُ الْعُلَمَا كُلٌّ بَطَلُ","tr":"","sadr":"ثُمَّ اْلآلِ الصَّحْبِ الْكُرَمَا","adj":"وَهُمُ الْعُلَمَا كُلٌّ بَطَلُ"}]}]}
