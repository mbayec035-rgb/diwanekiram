{"id":"ardu-t-tiwawuni-marhaban-wakaramatan","slug":"ardu-t-tiwawuni-marhaban-wakaramatan","chapters":[{"id":"ardu-t-tiwawuni-marhaban-wakaramatan-ch1","n":1,"verseCount":5,"verses":[{"id":"ardu-t-tiwawuni-marhaban-wakaramatan-c1-v1","n":1,"ar":"أَرْضُ التِّوَاوُنِ مَرْحَبًا وَكَرَامَةً فَاللهُ جَلَّ جَلَالُهُ أَعْلاَكِ","tr":"","sadr":"أَرْضُ التِّوَاوُنِ مَرْحَبًا وَكَرَامَةً","adj":"فَاللهُ جَلَّ جَلَالُهُ أَعْلاَكِ"},{"id":"ardu-t-tiwawuni-marhaban-wakaramatan-c1-v2","n":2,"ar":"حُيِّيتِ مِنْ عِزٍّ قَدِيمٍ دَائِمٍ حُيِّيتِ مِنْ فَخْرٍ وَلَا نَنْسَاكِ","tr":"","sadr":"حُيِّيتِ مِنْ عِزٍّ قَدِيمٍ دَائِمٍ","adj":"حُيِّيتِ مِنْ فَخْرٍ وَلَا نَنْسَاكِ"},{"id":"ardu-t-tiwawuni-marhaban-wakaramatan-c1-v3","n":3,"ar":"حُيِّيتِ مِنْ شَيْخٍ رَفِيعٍ مَرَاتِبٍ زُرْنَاكِ يَا أَرْضَ الْهُدَى زُرْنَاكِ","tr":"","sadr":"حُيِّيتِ مِنْ شَيْخٍ رَفِيعٍ مَرَاتِبٍ","adj":"زُرْنَاكِ يَا أَرْضَ الْهُدَى زُرْنَاكِ"},{"id":"ardu-t-tiwawuni-marhaban-wakaramatan-c1-v4","n":4,"ar":"زُرْنَاكِ حُبًّا وَاحْتِرَامًا بَعْدَ مَا خَيْرُ الْخَلِيفَةِ مَاشِيًا أَعْلَاكِ","tr":"","sadr":"زُرْنَاكِ حُبًّا وَاحْتِرَامًا بَعْدَ مَا","adj":"خَيْرُ الْخَلِيفَةِ مَاشِيًا أَعْلَاكِ"},{"id":"ardu-t-tiwawuni-marhaban-wakaramatan-c1-v5","n":5,"ar":"صَانَ الْخِلَافَةَ وَالْوَصِيَّةَ مَا بِهَا سَارٍ غَرِيبٌ أَوْ يَتِيمٌ بَاكِ","tr":"","sadr":"صَانَ الْخِلَافَةَ وَالْوَصِيَّةَ مَا بِهَا","adj":"سَارٍ غَرِيبٌ أَوْ يَتِيمٌ بَاكِ"}]}]}
