{"id":"nuniyyat-riyyu-z-zam-ani-fi-mawlidi-sayyidi-bani-adnana","slug":"nuniyyat-riyyu-z-zam-ani-fi-mawlidi-sayyidi-bani-adnana","chapters":[{"id":"nuniyyat-riyyu-z-zam-ani-fi-mawlidi-sayyidi-bani-adnana-ch1","n":1,"verseCount":121,"verses":[{"id":"nuniyyat-riyyu-z-zam-ani-fi-mawlidi-sayyidi-bani-adnana-c1-v1","n":1,"ar":"أَلَا يَا دَعْدُ وَيْحَكِ نَبِّئِينِي بِذِكْرِ الْبَانِ تَهْتَانُ الْعُيُونِ","tr":"","sadr":"أَلَا يَا دَعْدُ وَيْحَكِ نَبِّئِينِي","adj":"بِذِكْرِ الْبَانِ تَهْتَانُ الْعُيُونِ"},{"id":"nuniyyat-riyyu-z-zam-ani-fi-mawlidi-sayyidi-bani-adnana-c1-v2","n":2,"ar":"أَفِي بَيْـنٍ حِبَالُكِ أَمْ بِبَيْنٍ لِعُشَّاقٍ بِرَامَةَ خَبِّرِينِي","tr":"","sadr":"أَفِي بَيْـنٍ حِبَالُكِ أَمْ بِبَيْنٍ","adj":"لِعُشَّاقٍ بِرَامَةَ خَبِّرِينِي"},{"id":"nuniyyat-riyyu-z-zam-ani-fi-mawlidi-sayyidi-bani-adnana-c1-v3","n":3,"ar":"قِفِي نَبْكِي الْأَحِبَّةَ كَيْ نُدَاوِي ضَنًى فِينَا بِإِجْرَاءِ الشُّؤُونِ","tr":"","sadr":"قِفِي نَبْكِي الْأَحِبَّةَ كَيْ نُدَاوِي","adj":"ضَنًى فِينَا بِإِجْرَاءِ الشُّؤُونِ"},{"id":"nuniyyat-riyyu-z-zam-ani-fi-mawlidi-sayyidi-bani-adnana-c1-v4","n":4,"ar":"إِلَا مَا تَأْتَلِينَ بِكَيِّ قَلْبِي بِنَارِ الْحُبِّ كَيًّا غَيْرَ هُونِ","tr":"","sadr":"إِلَا مَا تَأْتَلِينَ بِكَيِّ قَلْبِي","adj":"بِنَارِ الْحُبِّ كَيًّا غَيْرَ هُونِ"},{"id":"nuniyyat-riyyu-z-zam-ani-fi-mawlidi-sayyidi-bani-adnana-c1-v5","n":5,"ar":"تُعِيرِينَ الْهَوَى فِي كُلِّ يَوْمٍ مُدًى تَفْرِي الْفُؤَادَ مَعَ الْوَتِينِ","tr":"","sadr":"تُعِيرِينَ الْهَوَى فِي كُلِّ يَوْمٍ","adj":"مُدًى تَفْرِي الْفُؤَادَ مَعَ الْوَتِينِ"},{"id":"nuniyyat-riyyu-z-zam-ani-fi-mawlidi-sayyidi-bani-adnana-c1-v6","n":6,"ar":"دَعِي عَنْكِ التَّغَنُّجَ ذَاتَ دَلٍّ بِهِ يَزْدَادُ قَلْبِي مِنْ فُتُونِ","tr":"","sadr":"دَعِي عَنْكِ التَّغَنُّجَ ذَاتَ دَلٍّ","adj":"بِهِ يَزْدَادُ قَلْبِي مِنْ فُتُونِ"},{"id":"nuniyyat-riyyu-z-zam-ani-fi-mawlidi-sayyidi-bani-adnana-c1-v7","n":7,"ar":"أَلَا حَبْلَ الْمَوَدَّةِ جَدِّدِيهَا فَفِي التَّجْدِيدِ نَحْيَى كُلَّ حِينِ","tr":"","sadr":"أَلَا حَبْلَ الْمَوَدَّةِ جَدِّدِيهَا","adj":"فَفِي التَّجْدِيدِ نَحْيَى كُلَّ حِينِ"},{"id":"nuniyyat-riyyu-z-zam-ani-fi-mawlidi-sayyidi-bani-adnana-c1-v8","n":8,"ar":"وَنَاجِينِي بِسِرِّ غَيْرِ فَاشٍ وَكُونِي بِالْمَعَاهِدِ ذَكِّرِينِي","tr":"","sadr":"وَنَاجِينِي بِسِرِّ غَيْرِ فَاشٍ","adj":"وَكُونِي بِالْمَعَاهِدِ ذَكِّرِينِي"},{"id":"nuniyyat-riyyu-z-zam-ani-fi-mawlidi-sayyidi-bani-adnana-c1-v9","n":9,"ar":"مَنَازِلَ قَدْ عَهِدْتُ بِهَا بِسَلْعٍ وَكَاظِمَةٍ جِنَانًا لِلْقَطِينِ","tr":"","sadr":"مَنَازِلَ قَدْ عَهِدْتُ بِهَا بِسَلْعٍ","adj":"وَكَاظِمَةٍ جِنَانًا لِلْقَطِينِ"},{"id":"nuniyyat-riyyu-z-zam-ani-fi-mawlidi-sayyidi-bani-adnana-c1-v10","n":10,"ar":"عَهِدْتُ بِهَا وَكُنْتُ رَخِيَّ بَالٍ أُحَادِثُ مِنْ حَدِيثٍ ذِي شُجُونِ","tr":"","sadr":"عَهِدْتُ بِهَا وَكُنْتُ رَخِيَّ بَالٍ","adj":"أُحَادِثُ مِنْ حَدِيثٍ ذِي شُجُونِ"},{"id":"nuniyyat-riyyu-z-zam-ani-fi-mawlidi-sayyidi-bani-adnana-c1-v11","n":11,"ar":"نَدَامَانَا بُدُورٌ نَيِّرَاتٌ يُقِرُّ الْعَيْنَ خِدْنٌ مِنْ تَنِينِ","tr":"","sadr":"نَدَامَانَا بُدُورٌ نَيِّرَاتٌ","adj":"يُقِرُّ الْعَيْنَ خِدْنٌ مِنْ تَنِينِ"},{"id":"nuniyyat-riyyu-z-zam-ani-fi-mawlidi-sayyidi-bani-adnana-c1-v12","n":12,"ar":"وَصَرْعَى صَرْخَدٍ كُنَّا نِيَامًا فَمَا يَقْظَانُ فِي دَاجِي الْجُنُونِ","tr":"","sadr":"وَصَرْعَى صَرْخَدٍ كُنَّا نِيَامًا","adj":"فَمَا يَقْظَانُ فِي دَاجِي الْجُنُونِ"},{"id":"nuniyyat-riyyu-z-zam-ani-fi-mawlidi-sayyidi-bani-adnana-c1-v13","n":13,"ar":"فَتُصْبِحُ أُمَّ مُوسَى مِنْ فَرَاغٍ وَقَدْ كُنَّا عَلَى طِيبِ الْقَرُونِ","tr":"","sadr":"فَتُصْبِحُ أُمَّ مُوسَى مِنْ فَرَاغٍ","adj":"وَقَدْ كُنَّا عَلَى طِيبِ الْقَرُونِ"},{"id":"nuniyyat-riyyu-z-zam-ani-fi-mawlidi-sayyidi-bani-adnana-c1-v14","n":14,"ar":"وَخِلْنَا وَالظُّنُونُ لَهَا غُرُورٌ مُسَالَمَةً مِنَ الدَّهْرِ الْخَؤُونِ","tr":"","sadr":"وَخِلْنَا وَالظُّنُونُ لَهَا غُرُورٌ","adj":"مُسَالَمَةً مِنَ الدَّهْرِ الْخَؤُونِ"},{"id":"nuniyyat-riyyu-z-zam-ani-fi-mawlidi-sayyidi-bani-adnana-c1-v15","n":15,"ar":"وَمَا كَذَبَ الزَّمَانُ بِأَنْ أَتَانَا وَنَحْنُ ذَوُو اغْتِرَارٍ بِالْحَجُونِ","tr":"","sadr":"وَمَا كَذَبَ الزَّمَانُ بِأَنْ أَتَانَا","adj":"وَنَحْنُ ذَوُو اغْتِرَارٍ بِالْحَجُونِ"},{"id":"nuniyyat-riyyu-z-zam-ani-fi-mawlidi-sayyidi-bani-adnana-c1-v16","n":16,"ar":"وكَانَ الدَّهْرُ يَرْمِينَا سِهَامًا فَأَفْنَى ذَاكَ عَادَتُهُ قُرُونِي","tr":"","sadr":"وكَانَ الدَّهْرُ يَرْمِينَا سِهَامًا","adj":"فَأَفْنَى ذَاكَ عَادَتُهُ قُرُونِي"},{"id":"nuniyyat-riyyu-z-zam-ani-fi-mawlidi-sayyidi-bani-adnana-c1-v17","n":17,"ar":"وَكُنْتُ أَرُومُ عُتْبَى الدَّهْرِ حَتَّى أَيِسْتُ بِذَاكَ مِنْ عِلْمِ الْيَقِينِ","tr":"","sadr":"وَكُنْتُ أَرُومُ عُتْبَى الدَّهْرِ حَتَّى","adj":"أَيِسْتُ بِذَاكَ مِنْ عِلْمِ الْيَقِينِ"},{"id":"nuniyyat-riyyu-z-zam-ani-fi-mawlidi-sayyidi-bani-adnana-c1-v18","n":18,"ar":"تُدَاوِلُنِي الْأَمَاكِنُ لَا أَنِيسٌ سِوَى شَدْوِ الْحَمَامِ عَلَى الْغُصُونِ","tr":"","sadr":"تُدَاوِلُنِي الْأَمَاكِنُ لَا أَنِيسٌ","adj":"سِوَى شَدْوِ الْحَمَامِ عَلَى الْغُصُونِ"},{"id":"nuniyyat-riyyu-z-zam-ani-fi-mawlidi-sayyidi-bani-adnana-c1-v19","n":19,"ar":"وَدَعْدًا قَدْ أُوَاعِدُ أَنْ تُسَلِّي فُؤَادِي أَوْ أَرَاحَ عَنِ الْهَنِينِ","tr":"","sadr":"وَدَعْدًا قَدْ أُوَاعِدُ أَنْ تُسَلِّي","adj":"فُؤَادِي أَوْ أَرَاحَ عَنِ الْهَنِينِ"},{"id":"nuniyyat-riyyu-z-zam-ani-fi-mawlidi-sayyidi-bani-adnana-c1-v20","n":20,"ar":"وَتَسْخَرُ بِي لِبُؤْسٍ وَاضْطِرَارٍ وَمَا حَنَّتْ بَلَى زَادَتْ شُجُونِي","tr":"","sadr":"وَتَسْخَرُ بِي لِبُؤْسٍ وَاضْطِرَارٍ","adj":"وَمَا حَنَّتْ بَلَى زَادَتْ شُجُونِي"},{"id":"nuniyyat-riyyu-z-zam-ani-fi-mawlidi-sayyidi-bani-adnana-c1-v21","n":21,"ar":"وَقَدْ أَفْنَى لَعَلَّ الْعُمْرَ مِنِّي وَدِينُ الْعِينِ أَقْبَحُ كُلِّ دِينِ","tr":"","sadr":"وَقَدْ أَفْنَى لَعَلَّ الْعُمْرَ مِنِّي","adj":"وَدِينُ الْعِينِ أَقْبَحُ كُلِّ دِينِ"},{"id":"nuniyyat-riyyu-z-zam-ani-fi-mawlidi-sayyidi-bani-adnana-c1-v22","n":22,"ar":"مَتَى مَا دَانَ بَحْرُكِ مِنْ كُدُورٍ فَصَافٍ سَلْسَلٌ بَحْرُ الْأَمِينِ","tr":"","sadr":"مَتَى مَا دَانَ بَحْرُكِ مِنْ كُدُورٍ","adj":"فَصَافٍ سَلْسَلٌ بَحْرُ الْأَمِينِ"},{"id":"nuniyyat-riyyu-z-zam-ani-fi-mawlidi-sayyidi-bani-adnana-c1-v23","n":23,"ar":"نَبِيٌّ عَبْقَرِيٌّ أَرْيَحِيٌّ صَفِيُّ اللَّهِ ذُو خُلُقٍ بَيُونِ","tr":"","sadr":"نَبِيٌّ عَبْقَرِيٌّ أَرْيَحِيٌّ","adj":"صَفِيُّ اللَّهِ ذُو خُلُقٍ بَيُونِ"},{"id":"nuniyyat-riyyu-z-zam-ani-fi-mawlidi-sayyidi-bani-adnana-c1-v24","n":24,"ar":"هُوَ الْعِرْنِينُ عِرْنِينُ الْبَرَايَا صَبِيحُ الْوَجْهِ ذُو خَلْقٍ حَسِينِ","tr":"","sadr":"هُوَ الْعِرْنِينُ عِرْنِينُ الْبَرَايَا","adj":"صَبِيحُ الْوَجْهِ ذُو خَلْقٍ حَسِينِ"},{"id":"nuniyyat-riyyu-z-zam-ani-fi-mawlidi-sayyidi-bani-adnana-c1-v25","n":25,"ar":"مَنِينٌ يَوْمَ ذُو إِثْمٍ مَنِينٌ مَنُونٌ غَيْرُ ذِي عُجْبٍ مَنُونِ","tr":"","sadr":"مَنِينٌ يَوْمَ ذُو إِثْمٍ مَنِينٌ","adj":"مَنُونٌ غَيْرُ ذِي عُجْبٍ مَنُونِ"},{"id":"nuniyyat-riyyu-z-zam-ani-fi-mawlidi-sayyidi-bani-adnana-c1-v26","n":26,"ar":"وَمِفْتَاحٌ وَمِصْبَاحٌ مُنِيرٌ جَوَادٌ مُصْطَفًى عَيْنُ الْعُيُونِ","tr":"","sadr":"وَمِفْتَاحٌ وَمِصْبَاحٌ مُنِيرٌ","adj":"جَوَادٌ مُصْطَفًى عَيْنُ الْعُيُونِ"},{"id":"nuniyyat-riyyu-z-zam-ani-fi-mawlidi-sayyidi-bani-adnana-c1-v27","n":27,"ar":"مُنَاجًى مُرْتَضًى هَادٍ بَشِيرٌ وَلَيْسَ عَلَى الْمُغَيَّبِ بِالظَّنِينِ","tr":"","sadr":"مُنَاجًى مُرْتَضًى هَادٍ بَشِيرٌ","adj":"وَلَيْسَ عَلَى الْمُغَيَّبِ بِالظَّنِينِ"},{"id":"nuniyyat-riyyu-z-zam-ani-fi-mawlidi-sayyidi-bani-adnana-c1-v28","n":28,"ar":"وَعَيْنُ الْخَلْقِ عَيْنًا قَدْ نَهَانَا يُبَيِّتُ مَنْ أَتَاهُ مِنَ الْعُيُونِ","tr":"","sadr":"وَعَيْنُ الْخَلْقِ عَيْنًا قَدْ نَهَانَا","adj":"يُبَيِّتُ مَنْ أَتَاهُ مِنَ الْعُيُونِ"},{"id":"nuniyyat-riyyu-z-zam-ani-fi-mawlidi-sayyidi-bani-adnana-c1-v29","n":29,"ar":"بِهِ عَيْنًا أُنِلْنَا لَيْسَ عَيْنٌ يُمَاثِلُهُ بِهِ نَيْلُ الْعُيُونِ","tr":"","sadr":"بِهِ عَيْنًا أُنِلْنَا لَيْسَ عَيْنٌ","adj":"يُمَاثِلُهُ بِهِ نَيْلُ الْعُيُونِ"},{"id":"nuniyyat-riyyu-z-zam-ani-fi-mawlidi-sayyidi-bani-adnana-c1-v30","n":30,"ar":"وَإِظْلَالٌ بِعَيْنِ فِي هَجِيرٍ فَإِرْهَاصٌ لَهُ كُلَّ الْعُيُونِ","tr":"","sadr":"وَإِظْلَالٌ بِعَيْنِ فِي هَجِيرٍ","adj":"فَإِرْهَاصٌ لَهُ كُلَّ الْعُيُونِ"},{"id":"nuniyyat-riyyu-z-zam-ani-fi-mawlidi-sayyidi-bani-adnana-c1-v31","n":31,"ar":"سِرَاجٌ مِنْ أَشِعَّتِهِ اسْتَنَرْنَا وَعَيْنٌ قَدْ زَرَتْ كُلَّ الْعُيُونِ","tr":"","sadr":"سِرَاجٌ مِنْ أَشِعَّتِهِ اسْتَنَرْنَا","adj":"وَعَيْنٌ قَدْ زَرَتْ كُلَّ الْعُيُونِ"},{"id":"nuniyyat-riyyu-z-zam-ani-fi-mawlidi-sayyidi-bani-adnana-c1-v32","n":32,"ar":"فَيَا عَجَبًا لِذِي نُورٍ مُنِيرٍ وَنُورُ الْأَصْلِ فِي مَاءٍ وَطِينِ","tr":"","sadr":"فَيَا عَجَبًا لِذِي نُورٍ مُنِيرٍ","adj":"وَنُورُ الْأَصْلِ فِي مَاءٍ وَطِينِ"},{"id":"nuniyyat-riyyu-z-zam-ani-fi-mawlidi-sayyidi-bani-adnana-c1-v33","n":33,"ar":"وَفِي صُلْبٍ لِإِلْيَاسٍ يُلَبِّي وَيَسْمَعُهُ الْمَوَاسِمُ بِالْأَذِينِ","tr":"","sadr":"وَفِي صُلْبٍ لِإِلْيَاسٍ يُلَبِّي","adj":"وَيَسْمَعُهُ الْمَوَاسِمُ بِالْأَذِينِ"},{"id":"nuniyyat-riyyu-z-zam-ani-fi-mawlidi-sayyidi-bani-adnana-c1-v34","n":34,"ar":"سَبَائِكُهُ الْجَوَاهِرَ مُزْرِيَاتٌ وَلِمْ لَا وَهُوَ عَيْنٌ لِلْعُيُونِ","tr":"","sadr":"سَبَائِكُهُ الْجَوَاهِرَ مُزْرِيَاتٌ","adj":"وَلِمْ لَا وَهُوَ عَيْنٌ لِلْعُيُونِ"},{"id":"nuniyyat-riyyu-z-zam-ani-fi-mawlidi-sayyidi-bani-adnana-c1-v35","n":35,"ar":"لَهُ قَبْلَ الْوِلادَةِ مُعْجِزَاتٌ تَرَاهَا أُمُّهُ دُونَ الظُّنُونِ","tr":"","sadr":"لَهُ قَبْلَ الْوِلادَةِ مُعْجِزَاتٌ","adj":"تَرَاهَا أُمُّهُ دُونَ الظُّنُونِ"},{"id":"nuniyyat-riyyu-z-zam-ani-fi-mawlidi-sayyidi-bani-adnana-c1-v36","n":36,"ar":"نَقِيٌّ فِي وِلَادَتِهِ عُجَابٌ يُعَيِّي كُلَّ ذِي عَقْلٍ بَنِينِ","tr":"","sadr":"نَقِيٌّ فِي وِلَادَتِهِ عُجَابٌ","adj":"يُعَيِّي كُلَّ ذِي عَقْلٍ بَنِينِ"},{"id":"nuniyyat-riyyu-z-zam-ani-fi-mawlidi-sayyidi-bani-adnana-c1-v37","n":37,"ar":"وَمَكْحُولًا وَمَسْرُورًا نَظِيفًا أَتَى يَوْمَ الْوِلَادَةِ فِي عُيُونِ","tr":"","sadr":"وَمَكْحُولًا وَمَسْرُورًا نَظِيفًا","adj":"أَتَى يَوْمَ الْوِلَادَةِ فِي عُيُونِ"},{"id":"nuniyyat-riyyu-z-zam-ani-fi-mawlidi-sayyidi-bani-adnana-c1-v38","n":38,"ar":"يُسَبِّحُ رَبَّهُ تَسْبِيحَ عَبْدٍ بَرُورٍ ذِي انْكِسَارٍ مُسْتَكِينِ","tr":"","sadr":"يُسَبِّحُ رَبَّهُ تَسْبِيحَ عَبْدٍ","adj":"بَرُورٍ ذِي انْكِسَارٍ مُسْتَكِينِ"},{"id":"nuniyyat-riyyu-z-zam-ani-fi-mawlidi-sayyidi-bani-adnana-c1-v39","n":39,"ar":"وَبَيْتُ اللَّهِ فِيهَا ذُو اضْطِرَابٍ فَيَا لَلَّهِ مِنْ شَهْمٍ مَكِينِ","tr":"","sadr":"وَبَيْتُ اللَّهِ فِيهَا ذُو اضْطِرَابٍ","adj":"فَيَا لَلَّهِ مِنْ شَهْمٍ مَكِينِ"},{"id":"nuniyyat-riyyu-z-zam-ani-fi-mawlidi-sayyidi-bani-adnana-c1-v40","n":40,"ar":"وَمَالَ الْبَيْتُ بِالْأَرْكَانِ حَتَّى يُكَبِّرَ سَاجِدًا مِثْلَ الْفَطِينِ","tr":"","sadr":"وَمَالَ الْبَيْتُ بِالْأَرْكَانِ حَتَّى","adj":"يُكَبِّرَ سَاجِدًا مِثْلَ الْفَطِينِ"},{"id":"nuniyyat-riyyu-z-zam-ani-fi-mawlidi-sayyidi-bani-adnana-c1-v41","n":41,"ar":"دَعَا الرُّهْبَانُ أَنْ جَانَا مُبِينٌ تَتَابَعَتِ الْهَوَاتِفُ لِلثَّخِينِ","tr":"","sadr":"دَعَا الرُّهْبَانُ أَنْ جَانَا مُبِينٌ","adj":"تَتَابَعَتِ الْهَوَاتِفُ لِلثَّخِينِ"},{"id":"nuniyyat-riyyu-z-zam-ani-fi-mawlidi-sayyidi-bani-adnana-c1-v42","n":42,"ar":"بِهَا حَلَّ الْكَوَاكِبُ مُشْرِقَاتٍ كَمَا حَلَّ الْمَلَائِكُ لِلْحَسِينِ","tr":"","sadr":"بِهَا حَلَّ الْكَوَاكِبُ مُشْرِقَاتٍ","adj":"كَمَا حَلَّ الْمَلَائِكُ لِلْحَسِينِ"},{"id":"nuniyyat-riyyu-z-zam-ani-fi-mawlidi-sayyidi-bani-adnana-c1-v43","n":43,"ar":"وَلِلْإِيوَانِ وَالشُّرُفَاتِ أَمْرٌ شَهِيرٌ وَالْمَذَلَّةُ لِلْقَطِينِ","tr":"","sadr":"وَلِلْإِيوَانِ وَالشُّرُفَاتِ أَمْرٌ","adj":"شَهِيرٌ وَالْمَذَلَّةُ لِلْقَطِينِ"},{"id":"nuniyyat-riyyu-z-zam-ani-fi-mawlidi-sayyidi-bani-adnana-c1-v44","n":44,"ar":"بِهَا نِيرَانُ فُرْسٍ هَامِدَاتٌ وَمَا لِلْبَحْرِ مِنْ مَاءٍ مَعِينِ","tr":"","sadr":"بِهَا نِيرَانُ فُرْسٍ هَامِدَاتٌ","adj":"وَمَا لِلْبَحْرِ مِنْ مَاءٍ مَعِينِ"},{"id":"nuniyyat-riyyu-z-zam-ani-fi-mawlidi-sayyidi-bani-adnana-c1-v45","n":45,"ar":"بِهَا أَنَّ اللَّعِينُ بِهَا رُجُومٌ تَرَمَّتْ لِلشَّيَاطِينِ الشُّطُونِ","tr":"","sadr":"بِهَا أَنَّ اللَّعِينُ بِهَا رُجُومٌ","adj":"تَرَمَّتْ لِلشَّيَاطِينِ الشُّطُونِ"},{"id":"nuniyyat-riyyu-z-zam-ani-fi-mawlidi-sayyidi-bani-adnana-c1-v46","n":46,"ar":"سَلِ الْأَصْنَامَ هَلْ نُكِسَتْ بِرَغْمٍ ذَوُو الْأَوْثَانِ فِي دِينٍ وَدِينِ","tr":"","sadr":"سَلِ الْأَصْنَامَ هَلْ نُكِسَتْ بِرَغْمٍ","adj":"ذَوُو الْأَوْثَانِ فِي دِينٍ وَدِينِ"},{"id":"nuniyyat-riyyu-z-zam-ani-fi-mawlidi-sayyidi-bani-adnana-c1-v47","n":47,"ar":"لِمَا فِي جَوْفِهَا إِنْشَاءُ شِعْرٍ يُطَرِّبُ كُلَّ ذِي دِينٍ وَدِينِ","tr":"","sadr":"لِمَا فِي جَوْفِهَا إِنْشَاءُ شِعْرٍ","adj":"يُطَرِّبُ كُلَّ ذِي دِينٍ وَدِينِ"},{"id":"nuniyyat-riyyu-z-zam-ani-fi-mawlidi-sayyidi-bani-adnana-c1-v48","n":48,"ar":"مُجَاوِبَ سَائِلِي الْأَصْنَامِ مَاذَا يُمِيلُكُمُ وَدُمْتُمْ فِي الرَّكُونِ","tr":"","sadr":"مُجَاوِبَ سَائِلِي الْأَصْنَامِ مَاذَا","adj":"يُمِيلُكُمُ وَدُمْتُمْ فِي الرَّكُونِ"},{"id":"nuniyyat-riyyu-z-zam-ani-fi-mawlidi-sayyidi-bani-adnana-c1-v49","n":49,"ar":"فَمُفْتَقِرٌ بِمُفْتَقِرِ يُنَادِي يُضَاعِفُ ضُعْفَهُ فِي كُلِ حِينِ","tr":"","sadr":"فَمُفْتَقِرٌ بِمُفْتَقِرِ يُنَادِي","adj":"يُضَاعِفُ ضُعْفَهُ فِي كُلِ حِينِ"},{"id":"nuniyyat-riyyu-z-zam-ani-fi-mawlidi-sayyidi-bani-adnana-c1-v50","n":50,"ar":"وَعَامٌ ثُمَّ شَهْرٌ ثُمَّ يَوْمٌ أَتَى فِيهِ الْهُدَى قَرْنُ الْقُرُونِ","tr":"","sadr":"وَعَامٌ ثُمَّ شَهْرٌ ثُمَّ يَوْمٌ","adj":"أَتَى فِيهِ الْهُدَى قَرْنُ الْقُرُونِ"},{"id":"nuniyyat-riyyu-z-zam-ani-fi-mawlidi-sayyidi-bani-adnana-c1-v51","n":51,"ar":"سُرُورٌ فِي سُرُورٍ فِي سُرُورٍ وَعِيدٌ دُونَ أَعْيَادِ الْعُيُونِ","tr":"","sadr":"سُرُورٌ فِي سُرُورٍ فِي سُرُورٍ","adj":"وَعِيدٌ دُونَ أَعْيَادِ الْعُيُونِ"},{"id":"nuniyyat-riyyu-z-zam-ani-fi-mawlidi-sayyidi-bani-adnana-c1-v52","n":52,"ar":"رَبِيعٌ وَالثِّنَى فِيهِ شَهِيرٌ بِعَامِ الْفِيلِ يَوْمًا بَعْدَ نُونِ","tr":"","sadr":"رَبِيعٌ وَالثِّنَى فِيهِ شَهِيرٌ","adj":"بِعَامِ الْفِيلِ يَوْمًا بَعْدَ نُونِ"},{"id":"nuniyyat-riyyu-z-zam-ani-fi-mawlidi-sayyidi-bani-adnana-c1-v53","n":53,"ar":"وَمَوْلِدُهُ بِهِ شَرَفٌ وَخِيرٌ فَفِي التَّعْظِيمِ إِنْجَاحُ الشُّجُونِ","tr":"","sadr":"وَمَوْلِدُهُ بِهِ شَرَفٌ وَخِيرٌ","adj":"فَفِي التَّعْظِيمِ إِنْجَاحُ الشُّجُونِ"},{"id":"nuniyyat-riyyu-z-zam-ani-fi-mawlidi-sayyidi-bani-adnana-c1-v54","n":54,"ar":"أَلَا سُرُرُ الْمُلُوكِ لَهَا جُفُولٌ وَنَجْمُ الْكُفْرِ ذُو نَحْسٍ مَهِينِ","tr":"","sadr":"أَلَا سُرُرُ الْمُلُوكِ لَهَا جُفُولٌ","adj":"وَنَجْمُ الْكُفْرِ ذُو نَحْسٍ مَهِينِ"},{"id":"nuniyyat-riyyu-z-zam-ani-fi-mawlidi-sayyidi-bani-adnana-c1-v55","n":55,"ar":"وَنَازَعَتِ الطُّيُورُ كَذَا وُحُوشٌ لِحَنَّانٍ يَكُونُ رِضَا الْقَطِينِ","tr":"","sadr":"وَنَازَعَتِ الطُّيُورُ كَذَا وُحُوشٌ","adj":"لِحَنَّانٍ يَكُونُ رِضَا الْقَطِينِ"},{"id":"nuniyyat-riyyu-z-zam-ani-fi-mawlidi-sayyidi-bani-adnana-c1-v56","n":56,"ar":"لِسَانُ الْقَدْرِ قَدْ نَادَى جِهَارًا بِهِ اخْتُصَّتْ حَلِيمَتُنَا بِدُونِ","tr":"","sadr":"لِسَانُ الْقَدْرِ قَدْ نَادَى جِهَارًا","adj":"بِهِ اخْتُصَّتْ حَلِيمَتُنَا بِدُونِ"},{"id":"nuniyyat-riyyu-z-zam-ani-fi-mawlidi-sayyidi-bani-adnana-c1-v57","n":57,"ar":"بِهِ تَابَ الْإِلَهُ عَلَى أَبِينَا بِهِ ذُو النُّونِ زَايَلَ بَطْنَ نُونِ","tr":"","sadr":"بِهِ تَابَ الْإِلَهُ عَلَى أَبِينَا","adj":"بِهِ ذُو النُّونِ زَايَلَ بَطْنَ نُونِ"},{"id":"nuniyyat-riyyu-z-zam-ani-fi-mawlidi-sayyidi-bani-adnana-c1-v58","n":58,"ar":"بِهِ بِشْرٌ وَإِحْيَاءٌ لِعِيسَى بِهِ قَالَ الْعَلِي: ”يَا نَارُ كُونِي“","tr":"","sadr":"بِهِ بِشْرٌ وَإِحْيَاءٌ لِعِيسَى","adj":"بِهِ قَالَ الْعَلِي: ”يَا نَارُ كُونِي“"},{"id":"nuniyyat-riyyu-z-zam-ani-fi-mawlidi-sayyidi-bani-adnana-c1-v59","n":59,"ar":"بِهِ يَعْقُوبُ مُرْتَدٌّ بَصِيرًا بِهِ لُوطٌ يُنَجَّى مِنْ قُرُونِ","tr":"","sadr":"بِهِ يَعْقُوبُ مُرْتَدٌّ بَصِيرًا","adj":"بِهِ لُوطٌ يُنَجَّى مِنْ قُرُونِ"},{"id":"nuniyyat-riyyu-z-zam-ani-fi-mawlidi-sayyidi-bani-adnana-c1-v60","n":60,"ar":"بِهِ حَازَ الذَّبِيحُ فِدَاءَ ذِبْحٍ بِهِ ذُو الْجُبِّ يَنْجُو مِنْ شَطُونِ","tr":"","sadr":"بِهِ حَازَ الذَّبِيحُ فِدَاءَ ذِبْحٍ","adj":"بِهِ ذُو الْجُبِّ يَنْجُو مِنْ شَطُونِ"},{"id":"nuniyyat-riyyu-z-zam-ani-fi-mawlidi-sayyidi-bani-adnana-c1-v61","n":61,"ar":"بِهِ ذُو الْفُلْكِ غِيضَ الْمَاءُ عَنْهُ بِهِ مُوسَى يُنَجَّى مِنْ شَحُونِ","tr":"","sadr":"بِهِ ذُو الْفُلْكِ غِيضَ الْمَاءُ عَنْهُ","adj":"بِهِ مُوسَى يُنَجَّى مِنْ شَحُونِ"},{"id":"nuniyyat-riyyu-z-zam-ani-fi-mawlidi-sayyidi-bani-adnana-c1-v62","n":62,"ar":"بِهِ ذُو الْمُلْكِ مُلِّكَ مَا تَمَنَّى بِهِ نِلْنَا فَنَشْكُرُ كُلَّ دِينِ","tr":"","sadr":"بِهِ ذُو الْمُلْكِ مُلِّكَ مَا تَمَنَّى","adj":"بِهِ نِلْنَا فَنَشْكُرُ كُلَّ دِينِ"},{"id":"nuniyyat-riyyu-z-zam-ani-fi-mawlidi-sayyidi-bani-adnana-c1-v63","n":63,"ar":"دَعِ الْإِطْنَابَ قُلْ كُلَّ الْبَرَايَا أُنِيلُوا مَا أُنِيلُوا بِالْمُبِينِ","tr":"","sadr":"دَعِ الْإِطْنَابَ قُلْ كُلَّ الْبَرَايَا","adj":"أُنِيلُوا مَا أُنِيلُوا بِالْمُبِينِ"},{"id":"nuniyyat-riyyu-z-zam-ani-fi-mawlidi-sayyidi-bani-adnana-c1-v64","n":64,"ar":"إِذِ الْإِيجَادُ وَالْإِمْدَادُ مِنْهُ نَبِيٌّ بِثْنَةٌ عَيْنُ الْحُصُونِ","tr":"","sadr":"إِذِ الْإِيجَادُ وَالْإِمْدَادُ مِنْهُ","adj":"نَبِيٌّ بِثْنَةٌ عَيْنُ الْحُصُونِ"},{"id":"nuniyyat-riyyu-z-zam-ani-fi-mawlidi-sayyidi-bani-adnana-c1-v65","n":65,"ar":"رَقَى فَوْقَ الْبُرَاقِ إِلَى سَمَاءٍ وَدَانَ لَهُ الْمَلَائِكُ أَيَّ دِينِ","tr":"","sadr":"رَقَى فَوْقَ الْبُرَاقِ إِلَى سَمَاءٍ","adj":"وَدَانَ لَهُ الْمَلَائِكُ أَيَّ دِينِ"},{"id":"nuniyyat-riyyu-z-zam-ani-fi-mawlidi-sayyidi-bani-adnana-c1-v66","n":66,"ar":"وَفِي الْإِسْرَاءِ قَالُوا غَيْرَ هَزْلٍ رَأَى الْمَوْلَى فَقَطَّفَ خَيْرَ دِينِ","tr":"","sadr":"وَفِي الْإِسْرَاءِ قَالُوا غَيْرَ هَزْلٍ","adj":"رَأَى الْمَوْلَى فَقَطَّفَ خَيْرَ دِينِ"},{"id":"nuniyyat-riyyu-z-zam-ani-fi-mawlidi-sayyidi-bani-adnana-c1-v67","n":67,"ar":"عَلَيْنَا الْحَمْدُ حَمْدًا قَرَّ حِينًا شَفَى عَنَّا الْمُقَفِّي كُلَّ دِينِ","tr":"","sadr":"عَلَيْنَا الْحَمْدُ حَمْدًا قَرَّ حِينًا","adj":"شَفَى عَنَّا الْمُقَفِّي كُلَّ دِينِ"},{"id":"nuniyyat-riyyu-z-zam-ani-fi-mawlidi-sayyidi-bani-adnana-c1-v68","n":68,"ar":"فَنَحْمَدُهُ وَنَشْكُرُهُ دَوَامًا كَذِي الْإِمْحَالِ مُنَّ لَهُ بِدِينِ","tr":"","sadr":"فَنَحْمَدُهُ وَنَشْكُرُهُ دَوَامًا","adj":"كَذِي الْإِمْحَالِ مُنَّ لَهُ بِدِينِ"},{"id":"nuniyyat-riyyu-z-zam-ani-fi-mawlidi-sayyidi-bani-adnana-c1-v69","n":69,"ar":"نَبِيٌّ كَانَ قَبْلَ الْكَوْنِ نُورًا فَجَانٍ قَبْلَ وَحْيٍ كُلَّ دِينِ","tr":"","sadr":"نَبِيٌّ كَانَ قَبْلَ الْكَوْنِ نُورًا","adj":"فَجَانٍ قَبْلَ وَحْيٍ كُلَّ دِينِ"},{"id":"nuniyyat-riyyu-z-zam-ani-fi-mawlidi-sayyidi-bani-adnana-c1-v70","n":70,"ar":"أَتَى وَالْكُفْرُ فِي جَوْرٍ وَظُلْمٍ فَقَادَ الْكُلَّ عَنْ دِينٍ لِدِينِ","tr":"","sadr":"أَتَى وَالْكُفْرُ فِي جَوْرٍ وَظُلْمٍ","adj":"فَقَادَ الْكُلَّ عَنْ دِينٍ لِدِينِ"},{"id":"nuniyyat-riyyu-z-zam-ani-fi-mawlidi-sayyidi-bani-adnana-c1-v71","n":71,"ar":"وَسِيلَتُنَا نَفَى فِي الدِّينِ دِينًا تَبَيَّنَ رُشْدُنَا فِي كُلِّ دِينِ","tr":"","sadr":"وَسِيلَتُنَا نَفَى فِي الدِّينِ دِينًا","adj":"تَبَيَّنَ رُشْدُنَا فِي كُلِّ دِينِ"},{"id":"nuniyyat-riyyu-z-zam-ani-fi-mawlidi-sayyidi-bani-adnana-c1-v72","n":72,"ar":"دَعَا مَنْ لَمْ يُجِبْهُ يَنَالُ هُلْكًا وَمُؤْتَمِرٌ يُثَابُ بِغَيْرِ دِينِ","tr":"","sadr":"دَعَا مَنْ لَمْ يُجِبْهُ يَنَالُ هُلْكًا","adj":"وَمُؤْتَمِرٌ يُثَابُ بِغَيْرِ دِينِ"},{"id":"nuniyyat-riyyu-z-zam-ani-fi-mawlidi-sayyidi-bani-adnana-c1-v73","n":73,"ar":"أَلَا الْمُخْتَارُ خُيّرَ دُونَ مَيْنٍ وَلَمْ يَخْتَرْ بِحَقٍّ نَيْلَ دِينِ","tr":"","sadr":"أَلَا الْمُخْتَارُ خُيّرَ دُونَ مَيْنٍ","adj":"وَلَمْ يَخْتَرْ بِحَقٍّ نَيْلَ دِينِ"},{"id":"nuniyyat-riyyu-z-zam-ani-fi-mawlidi-sayyidi-bani-adnana-c1-v74","n":74,"ar":"وَبِالْهَادِي دُعِينَا خَيْرَ قَوْمٍ وَبِالْإِرْسَالِ سُدْنَا كُلَّ دِينِ","tr":"","sadr":"وَبِالْهَادِي دُعِينَا خَيْرَ قَوْمٍ","adj":"وَبِالْإِرْسَالِ سُدْنَا كُلَّ دِينِ"},{"id":"nuniyyat-riyyu-z-zam-ani-fi-mawlidi-sayyidi-bani-adnana-c1-v75","n":75,"ar":"وَقُلْ قُرَشِي وَقُلْ عَرَبِي تُصَدَّقْ وَصِدْقُ الْقَوْلِ حَقًّا زَيْنُ دِينِ","tr":"","sadr":"وَقُلْ قُرَشِي وَقُلْ عَرَبِي تُصَدَّقْ","adj":"وَصِدْقُ الْقَوْلِ حَقًّا زَيْنُ دِينِ"},{"id":"nuniyyat-riyyu-z-zam-ani-fi-mawlidi-sayyidi-bani-adnana-c1-v76","n":76,"ar":"شَفِيعٌ صَفْوَةٌ بَرٌّ رَؤُوفٌ هُدًى يَهْدِي الْمَدِينَ لِخَيْرِ دِينِ","tr":"","sadr":"شَفِيعٌ صَفْوَةٌ بَرٌّ رَؤُوفٌ","adj":"هُدًى يَهْدِي الْمَدِينَ لِخَيْرِ دِينِ"},{"id":"nuniyyat-riyyu-z-zam-ani-fi-mawlidi-sayyidi-bani-adnana-c1-v77","n":77,"ar":"وَفِي الْحَجَرِ الْقَضَاءُ لَهُ شَهِيرٌ فَذَاكَ الْحُكْمُ دِينٌ خَيْرُ دِينِ","tr":"","sadr":"وَفِي الْحَجَرِ الْقَضَاءُ لَهُ شَهِيرٌ","adj":"فَذَاكَ الْحُكْمُ دِينٌ خَيْرُ دِينِ"},{"id":"nuniyyat-riyyu-z-zam-ani-fi-mawlidi-sayyidi-bani-adnana-c1-v78","n":78,"ar":"لِهَادِينَا نِظَامٌ يَا مَفَازًا لِمُنْتَهجِي نِظَامٍ خَيْرِ دِينِ","tr":"","sadr":"لِهَادِينَا نِظَامٌ يَا مَفَازًا","adj":"لِمُنْتَهجِي نِظَامٍ خَيْرِ دِينِ"},{"id":"nuniyyat-riyyu-z-zam-ani-fi-mawlidi-sayyidi-bani-adnana-c1-v79","n":79,"ar":"سَبَقْنَا مَنْ سِوَانَا أَيَّ سَبْقٍ بِهِ دِنَّا الْأَعَادِي كُلَّ دِينِ","tr":"","sadr":"سَبَقْنَا مَنْ سِوَانَا أَيَّ سَبْقٍ","adj":"بِهِ دِنَّا الْأَعَادِي كُلَّ دِينِ"},{"id":"nuniyyat-riyyu-z-zam-ani-fi-mawlidi-sayyidi-bani-adnana-c1-v80","n":80,"ar":"بِهِ دِنَّا وَدَانَ الْغَيْرُ خَيْرًا وَشَرًّا يَا إِلَهِي قَوِّدُونِي","tr":"","sadr":"بِهِ دِنَّا وَدَانَ الْغَيْرُ خَيْرًا","adj":"وَشَرًّا يَا إِلَهِي قَوِّدُونِي"},{"id":"nuniyyat-riyyu-z-zam-ani-fi-mawlidi-sayyidi-bani-adnana-c1-v81","n":81,"ar":"حَنَانٌ بَلْ حَنَانٌ بَلْ حَنَانٌ حَنَانٌ بَلْ حَنَانٌ أَخِي الْحَنِينِ","tr":"","sadr":"حَنَانٌ بَلْ حَنَانٌ بَلْ حَنَانٌ","adj":"حَنَانٌ بَلْ حَنَانٌ أَخِي الْحَنِينِ"},{"id":"nuniyyat-riyyu-z-zam-ani-fi-mawlidi-sayyidi-bani-adnana-c1-v82","n":82,"ar":"وَسُنَّتُهُ تُخَجِّلُ مِنْ بُدُورٍ وَلَا تَطْلُبْ لِهَذَا مِنْ حَنِينِ","tr":"","sadr":"وَسُنَّتُهُ تُخَجِّلُ مِنْ بُدُورٍ","adj":"وَلَا تَطْلُبْ لِهَذَا مِنْ حَنِينِ"},{"id":"nuniyyat-riyyu-z-zam-ani-fi-mawlidi-sayyidi-bani-adnana-c1-v83","n":83,"ar":"شَفِيقٌ كَانَ أُمَّتَهُ رَحِيمًا وَلَيْسَ لَهُ الْمُشَابِهُ مِنْ حَنِينِ","tr":"","sadr":"شَفِيقٌ كَانَ أُمَّتَهُ رَحِيمًا","adj":"وَلَيْسَ لَهُ الْمُشَابِهُ مِنْ حَنِينِ"},{"id":"nuniyyat-riyyu-z-zam-ani-fi-mawlidi-sayyidi-bani-adnana-c1-v84","n":84,"ar":"وَمَدْحُ الْمُصْطَفَى فَوْزُ وَغُنْمٌ فَمَا حَرَجٌ عَلَيَّ مِنَ الْحَنِينِ","tr":"","sadr":"وَمَدْحُ الْمُصْطَفَى فَوْزُ وَغُنْمٌ","adj":"فَمَا حَرَجٌ عَلَيَّ مِنَ الْحَنِينِ"},{"id":"nuniyyat-riyyu-z-zam-ani-fi-mawlidi-sayyidi-bani-adnana-c1-v85","n":85,"ar":"رَسُولٌ كُلُّ حَاذٍ مَا أَتَانَا يَفُوقُ لَدَى التَّلَاقِي كُلَّ دُونِ","tr":"","sadr":"رَسُولٌ كُلُّ حَاذٍ مَا أَتَانَا","adj":"يَفُوقُ لَدَى التَّلَاقِي كُلَّ دُونِ"},{"id":"nuniyyat-riyyu-z-zam-ani-fi-mawlidi-sayyidi-bani-adnana-c1-v86","n":86,"ar":"وَأَهْلُ الْعُلْوِ وَالرُّسَلَاءُ طُرًّا يَؤُمُّهُمُ إِمَامَةَ غَيْرِ دُونِ","tr":"","sadr":"وَأَهْلُ الْعُلْوِ وَالرُّسَلَاءُ طُرًّا","adj":"يَؤُمُّهُمُ إِمَامَةَ غَيْرِ دُونِ"},{"id":"nuniyyat-riyyu-z-zam-ani-fi-mawlidi-sayyidi-bani-adnana-c1-v87","n":87,"ar":"هُوَ الْخَتْمُ الْإِمَامُ وَذُو اقْتِدَاءٍ مَكَانَتُهُ الْمَكَانَةُ دُونَ دُونِ","tr":"","sadr":"هُوَ الْخَتْمُ الْإِمَامُ وَذُو اقْتِدَاءٍ","adj":"مَكَانَتُهُ الْمَكَانَةُ دُونَ دُونِ"},{"id":"nuniyyat-riyyu-z-zam-ani-fi-mawlidi-sayyidi-bani-adnana-c1-v88","n":88,"ar":"وَدُونَ الْبَدْرِ دُونَ اللهِ حَقًّا جَمِيعُ الرُّسُلِ تَعْلَمُ دُونَ حِينِ","tr":"","sadr":"وَدُونَ الْبَدْرِ دُونَ اللهِ حَقًّا","adj":"جَمِيعُ الرُّسُلِ تَعْلَمُ دُونَ حِينِ"},{"id":"nuniyyat-riyyu-z-zam-ani-fi-mawlidi-sayyidi-bani-adnana-c1-v89","n":89,"ar":"مَزُونُ الْوَجْهِ فَالْأَمْطَارُ فَارَتْ وَوَلَّتْ بِالدُّعَاءِ عَلَى الْمُزُونِ","tr":"","sadr":"مَزُونُ الْوَجْهِ فَالْأَمْطَارُ فَارَتْ","adj":"وَوَلَّتْ بِالدُّعَاءِ عَلَى الْمُزُونِ"},{"id":"nuniyyat-riyyu-z-zam-ani-fi-mawlidi-sayyidi-bani-adnana-c1-v90","n":90,"ar":"نَفَى جُوعَ الْأُلُوفِ بِغَيْرِ رَيْبٍ سَمَيْدَعُنَا بِصَاعٍ مِنْ عَجِينِ","tr":"","sadr":"نَفَى جُوعَ الْأُلُوفِ بِغَيْرِ رَيْبٍ","adj":"سَمَيْدَعُنَا بِصَاعٍ مِنْ عَجِينِ"},{"id":"nuniyyat-riyyu-z-zam-ani-fi-mawlidi-sayyidi-bani-adnana-c1-v91","n":91,"ar":"وَغُلَّتُهُمْ بِهِ زَالَتْ زُعَاقٌ نَمِيرٌ سَائِغٌ مِنْ ذَا الْأَمِينِ","tr":"","sadr":"وَغُلَّتُهُمْ بِهِ زَالَتْ زُعَاقٌ","adj":"نَمِيرٌ سَائِغٌ مِنْ ذَا الْأَمِينِ"},{"id":"nuniyyat-riyyu-z-zam-ani-fi-mawlidi-sayyidi-bani-adnana-c1-v92","n":92,"ar":"بِهِ فَارَ الرَّكَايَا شُقَّ بَدْرٌ كَشَقِّ الصَّدْرِ هَاءً دُونَ ذِينِ","tr":"","sadr":"بِهِ فَارَ الرَّكَايَا شُقَّ بَدْرٌ","adj":"كَشَقِّ الصَّدْرِ هَاءً دُونَ ذِينِ"},{"id":"nuniyyat-riyyu-z-zam-ani-fi-mawlidi-sayyidi-bani-adnana-c1-v93","n":93,"ar":"وَرُبَّ بَهِيمَةٍ شَهِدَتْ بِحَقٍّ رِسَالَتَهُ كَمَا ضَبٍّ مُبِينِ","tr":"","sadr":"وَرُبَّ بَهِيمَةٍ شَهِدَتْ بِحَقٍّ","adj":"رِسَالَتَهُ كَمَا ضَبٍّ مُبِينِ"},{"id":"nuniyyat-riyyu-z-zam-ani-fi-mawlidi-sayyidi-bani-adnana-c1-v94","n":94,"ar":"وَظَبْيَتُهُ تَخَوَّنَ فِي وَفَاءٍ وَكَانَ الْجِذْعُ شَوْقًا مِنْ حَنِينِ","tr":"","sadr":"وَظَبْيَتُهُ تَخَوَّنَ فِي وَفَاءٍ","adj":"وَكَانَ الْجِذْعُ شَوْقًا مِنْ حَنِينِ"},{"id":"nuniyyat-riyyu-z-zam-ani-fi-mawlidi-sayyidi-bani-adnana-c1-v95","n":95,"ar":"وَهَاجَرَ كُلَّ ذِي بَغْيٍ غَبِيٍّ بِهِجْرَتِهِ لِبِينٍ خَيْرِ بِينِ","tr":"","sadr":"وَهَاجَرَ كُلَّ ذِي بَغْيٍ غَبِيٍّ","adj":"بِهِجْرَتِهِ لِبِينٍ خَيْرِ بِينِ"},{"id":"nuniyyat-riyyu-z-zam-ani-fi-mawlidi-sayyidi-bani-adnana-c1-v96","n":96,"ar":"وَفِي الْغَارِ الْعَجَائِبُ بَادِيَاتٌ وَسَلْ مَا لِلْعَنَاكِبِ وَالشَّجُونِ","tr":"","sadr":"وَفِي الْغَارِ الْعَجَائِبُ بَادِيَاتٌ","adj":"وَسَلْ مَا لِلْعَنَاكِبِ وَالشَّجُونِ"},{"id":"nuniyyat-riyyu-z-zam-ani-fi-mawlidi-sayyidi-bani-adnana-c1-v97","n":97,"ar":"غِنَاءُ الْجِنِّ أَطْرَبَ سَامِعِيهِ وَيُعْلِمُ رَكْنَهُ مَنْوَى الْمَصُونِ","tr":"","sadr":"غِنَاءُ الْجِنِّ أَطْرَبَ سَامِعِيهِ","adj":"وَيُعْلِمُ رَكْنَهُ مَنْوَى الْمَصُونِ"},{"id":"nuniyyat-riyyu-z-zam-ani-fi-mawlidi-sayyidi-bani-adnana-c1-v98","n":98,"ar":"غَزَا الْغَزَوَاتِ مُرْدِيَةَ الْأَعَادِي وَكُلُّهُمْ عَلَى هُونٍ وَهُونِ","tr":"","sadr":"غَزَا الْغَزَوَاتِ مُرْدِيَةَ الْأَعَادِي","adj":"وَكُلُّهُمْ عَلَى هُونٍ وَهُونِ"},{"id":"nuniyyat-riyyu-z-zam-ani-fi-mawlidi-sayyidi-bani-adnana-c1-v99","n":99,"ar":"بِهَا الْأَبْطَالُ زَارَهُمُ صَغَارٌ وَمَا يُغْنِيهِمُ عَالِي الْقُرُونِ","tr":"","sadr":"بِهَا الْأَبْطَالُ زَارَهُمُ صَغَارٌ","adj":"وَمَا يُغْنِيهِمُ عَالِي الْقُرُونِ"},{"id":"nuniyyat-riyyu-z-zam-ani-fi-mawlidi-sayyidi-bani-adnana-c1-v100","n":100,"ar":"وَمَا يُغْنِي الدُّرُوعُ وَلَا الْعَوَالِي وَمَا لَهُمْ تَفَلَّلَ مِنْ حُصُونِ","tr":"","sadr":"وَمَا يُغْنِي الدُّرُوعُ وَلَا الْعَوَالِي","adj":"وَمَا لَهُمْ تَفَلَّلَ مِنْ حُصُونِ"},{"id":"nuniyyat-riyyu-z-zam-ani-fi-mawlidi-sayyidi-bani-adnana-c1-v101","n":101,"ar":"وَلَا تَعْجَبْ وَيَوْمَ الْبَدْرِ جَاءُوا جُنُودُ اللَّهِ مِنْ أَمْرِ الْمُعِينِ","tr":"","sadr":"وَلَا تَعْجَبْ وَيَوْمَ الْبَدْرِ جَاءُوا","adj":"جُنُودُ اللَّهِ مِنْ أَمْرِ الْمُعِينِ"},{"id":"nuniyyat-riyyu-z-zam-ani-fi-mawlidi-sayyidi-bani-adnana-c1-v102","n":102,"ar":"وَقَدْ سَمِعَ الصَّحَابَةُ قَوْلَ جِبْرِيـ ـلَ يَا حَيْزُومُ أَقْدِمْ بِالْمُزُونِ","tr":"","sadr":"وَقَدْ سَمِعَ الصَّحَابَةُ قَوْلَ جِبْرِيـ","adj":"ـلَ يَا حَيْزُومُ أَقْدِمْ بِالْمُزُونِ"},{"id":"nuniyyat-riyyu-z-zam-ani-fi-mawlidi-sayyidi-bani-adnana-c1-v103","n":103,"ar":"وَدُونَهُمُ الْعَمَائِمُ وَهْيَ بِيضٌ وَقَدْ نَزَلُوا مِنَ الْحَرْبِ الشَّطُونِ","tr":"","sadr":"وَدُونَهُمُ الْعَمَائِمُ وَهْيَ بِيضٌ","adj":"وَقَدْ نَزَلُوا مِنَ الْحَرْبِ الشَّطُونِ"},{"id":"nuniyyat-riyyu-z-zam-ani-fi-mawlidi-sayyidi-bani-adnana-c1-v104","n":104,"ar":"وَأَصْوَاتُ الْخُيُولِ رُعُودُ بَرْقٍ فَتَانُ الْحَرْبِ يَزْرِي بِالرَّعُونِ","tr":"","sadr":"وَأَصْوَاتُ الْخُيُولِ رُعُودُ بَرْقٍ","adj":"فَتَانُ الْحَرْبِ يَزْرِي بِالرَّعُونِ"},{"id":"nuniyyat-riyyu-z-zam-ani-fi-mawlidi-sayyidi-bani-adnana-c1-v105","n":105,"ar":"وَيَوْمٍ قَدْ تَسَجَّدَ فِيهِ حَمْدًا غَرَابِيبٌ وَنَسْرٌ فِعْلَ نُونِ","tr":"","sadr":"وَيَوْمٍ قَدْ تَسَجَّدَ فِيهِ حَمْدًا","adj":"غَرَابِيبٌ وَنَسْرٌ فِعْلَ نُونِ"},{"id":"nuniyyat-riyyu-z-zam-ani-fi-mawlidi-sayyidi-bani-adnana-c1-v106","n":106,"ar":"وَعُثْمَانٌ بِأَلْوَاحِ الْأَعَادِي بِأَنْوَانٍ يَخُطُّ كَمِثْلِ نُونِ","tr":"","sadr":"وَعُثْمَانٌ بِأَلْوَاحِ الْأَعَادِي","adj":"بِأَنْوَانٍ يَخُطُّ كَمِثْلِ نُونِ"},{"id":"nuniyyat-riyyu-z-zam-ani-fi-mawlidi-sayyidi-bani-adnana-c1-v107","n":107,"ar":"وَلِلْحَجَّاجِ وَالدُّؤَلِيِّ نَقْطٌ وَشَكْلٌ بِالْقِرَانِ وَبِالْقَتِينِ","tr":"","sadr":"وَلِلْحَجَّاجِ وَالدُّؤَلِيِّ نَقْطٌ","adj":"وَشَكْلٌ بِالْقِرَانِ وَبِالْقَتِينِ"},{"id":"nuniyyat-riyyu-z-zam-ani-fi-mawlidi-sayyidi-bani-adnana-c1-v108","n":108,"ar":"حُسَيْنٌ لِلْأَعَادِي وَهُوَ جَوْدٌ لَدَى الْأَحْبَابِ يَزْرِي بِالْهَتُونِ","tr":"","sadr":"حُسَيْنٌ لِلْأَعَادِي وَهُوَ جَوْدٌ","adj":"لَدَى الْأَحْبَابِ يَزْرِي بِالْهَتُونِ"},{"id":"nuniyyat-riyyu-z-zam-ani-fi-mawlidi-sayyidi-bani-adnana-c1-v109","n":109,"ar":"وَقَدْ دَخَلُوا بِدِينِ اللهِ فَوْجًا وَأَفْوَاجًا عَلَى حَذَرِ القُفُونِ","tr":"","sadr":"وَقَدْ دَخَلُوا بِدِينِ اللهِ فَوْجًا","adj":"وَأَفْوَاجًا عَلَى حَذَرِ القُفُونِ"},{"id":"nuniyyat-riyyu-z-zam-ani-fi-mawlidi-sayyidi-bani-adnana-c1-v110","n":110,"ar":"وَبِالْغَزَوَاتِ وَالْآيَاتِ جَاءُوا كَمَا جَاءُوا مِنَ الْوَجْهِ الْمَزُونِ","tr":"","sadr":"وَبِالْغَزَوَاتِ وَالْآيَاتِ جَاءُوا","adj":"كَمَا جَاءُوا مِنَ الْوَجْهِ الْمَزُونِ"},{"id":"nuniyyat-riyyu-z-zam-ani-fi-mawlidi-sayyidi-bani-adnana-c1-v111","n":111,"ar":"وَنَابَ بِهِ الْبُدُورُ لِمُقْتَدِيهِ إِلَهِي جَازِيَنْ خَيْرَ الْقُرُونِ","tr":"","sadr":"وَنَابَ بِهِ الْبُدُورُ لِمُقْتَدِيهِ","adj":"إِلَهِي جَازِيَنْ خَيْرَ الْقُرُونِ"},{"id":"nuniyyat-riyyu-z-zam-ani-fi-mawlidi-sayyidi-bani-adnana-c1-v112","n":112,"ar":"هُمُ الْخُلَفَاءُ مُحْتَازُوا الْمَعَالِي عُدُولٌ حَسَّنُوا اسْتِخْلَافَ دِينِ","tr":"","sadr":"هُمُ الْخُلَفَاءُ مُحْتَازُوا الْمَعَالِي","adj":"عُدُولٌ حَسَّنُوا اسْتِخْلَافَ دِينِ"},{"id":"nuniyyat-riyyu-z-zam-ani-fi-mawlidi-sayyidi-bani-adnana-c1-v113","n":113,"ar":"حَنَانَ اللهِ مِنْ نَهْجِ سِوَى مَا قَدِ انْتَهَجُوا وَمِنْ شَرِّ الْقَرِينِ","tr":"","sadr":"حَنَانَ اللهِ مِنْ نَهْجِ سِوَى مَا","adj":"قَدِ انْتَهَجُوا وَمِنْ شَرِّ الْقَرِينِ"},{"id":"nuniyyat-riyyu-z-zam-ani-fi-mawlidi-sayyidi-bani-adnana-c1-v114","n":114,"ar":"مَدَحْنَا الْمُصْطَفَى مَزْنًا عَجِيبًا لِيَغْفِرَ لِي الْغَفُورُ بِيَوْمِ دِينِ","tr":"","sadr":"مَدَحْنَا الْمُصْطَفَى مَزْنًا عَجِيبًا","adj":"لِيَغْفِرَ لِي الْغَفُورُ بِيَوْمِ دِينِ"},{"id":"nuniyyat-riyyu-z-zam-ani-fi-mawlidi-sayyidi-bani-adnana-c1-v115","n":115,"ar":"وَيَوْمٌ قَمْطَرِيرٌ زَمْهَرِيرٌ عَبُوسٌ شَرَّهُ خِفْنَا مُعِينِي","tr":"","sadr":"وَيَوْمٌ قَمْطَرِيرٌ زَمْهَرِيرٌ","adj":"عَبُوسٌ شَرَّهُ خِفْنَا مُعِينِي"},{"id":"nuniyyat-riyyu-z-zam-ani-fi-mawlidi-sayyidi-bani-adnana-c1-v116","n":116,"ar":"إِلَهِي يَا إِلَهِي يَا إِلَهِي إِلَهِي تَوْبَةً قَبْلَ الْمَنُونِ","tr":"","sadr":"إِلَهِي يَا إِلَهِي يَا إِلَهِي","adj":"إِلَهِي تَوْبَةً قَبْلَ الْمَنُونِ"},{"id":"nuniyyat-riyyu-z-zam-ani-fi-mawlidi-sayyidi-bani-adnana-c1-v117","n":117,"ar":"إِلَهِي رَبَّنَا هَبْ لِي نَجَاةً وَأَصْلِي وَالْمَشِيخَةِ وَالْقَطِينِ","tr":"","sadr":"إِلَهِي رَبَّنَا هَبْ لِي نَجَاةً","adj":"وَأَصْلِي وَالْمَشِيخَةِ وَالْقَطِينِ"},{"id":"nuniyyat-riyyu-z-zam-ani-fi-mawlidi-sayyidi-bani-adnana-c1-v118","n":118,"ar":"وَأَحْبَابِي وَذِي الْإِحْسَانِ رَبِّي إِلَيْنَا مَعْ جَمِيعِ الْمُسْلِمِينِ","tr":"","sadr":"وَأَحْبَابِي وَذِي الْإِحْسَانِ رَبِّي","adj":"إِلَيْنَا مَعْ جَمِيعِ الْمُسْلِمِينِ"},{"id":"nuniyyat-riyyu-z-zam-ani-fi-mawlidi-sayyidi-bani-adnana-c1-v119","n":119,"ar":"وَأَلْفُ الضَّعْفِ ضِعْفِ الْخَلْقِ رَبِّي مِنَ الصَّلَوَاتِ فِي الْبَرِّ الْمُبِينِ","tr":"","sadr":"وَأَلْفُ الضَّعْفِ ضِعْفِ الْخَلْقِ رَبِّي","adj":"مِنَ الصَّلَوَاتِ فِي الْبَرِّ الْمُبِينِ"},{"id":"nuniyyat-riyyu-z-zam-ani-fi-mawlidi-sayyidi-bani-adnana-c1-v120","n":120,"ar":"سَلَامٍ ضِعْفِ ذَلِكَ أَلْفَ أَلْفٍ يَعُمُّ الْآلَ حِينًا بَعْدَ حِينِ","tr":"","sadr":"سَلَامٍ ضِعْفِ ذَلِكَ أَلْفَ أَلْفٍ","adj":"يَعُمُّ الْآلَ حِينًا بَعْدَ حِينِ"},{"id":"nuniyyat-riyyu-z-zam-ani-fi-mawlidi-sayyidi-bani-adnana-c1-v121","n":121,"ar":"وَإِنَّ النَّظْمَ يَكْفِي ذَا طِلَابٍ فَنَظْمِي حِفْظُهُ حَوْزُ السُّجُونِ","tr":"","sadr":"وَإِنَّ النَّظْمَ يَكْفِي ذَا طِلَابٍ","adj":"فَنَظْمِي حِفْظُهُ حَوْزُ السُّجُونِ"}]}]}
