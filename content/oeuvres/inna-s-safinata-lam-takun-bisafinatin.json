        {
          "ar": "إِنَّ السَّفِينَةَ لَمْ تَكُنْ بِسَفِينَةٍ مَعْهُودَةٍ فِي بَطْنِهَا الرُّكَابُ",
          "sadr": "إِنَّ السَّفِينَةَ لَمْ تَكُنْ بِسَفِينَةٍ",
          "adj": "مَعْهُودَةٍ فِي بَطْنِهَا الرُّكَابُ"
        },
        {
          "ar": "بَلْ إِنَّهَا مَمْلُوءَةٌ بِبِضَاعةٍ بَيْنَ الْمَرَاسِي نَالَهَا حُسَّابُ",
          "sadr": "بَلْ إِنَّهَا مَمْلُوءَةٌ بِبِضَاعةٍ",
          "adj": "بَيْنَ الْمَرَاسِي نَالَهَا حُسَّابُ"
        },
        {
          "ar": "قَدْ أَفْزَعَتْ مِنَّا الْقُلُوبُ صَرَاخَةٌ وَتَدَهَّشَتْ فِي دَوْيِهَا الْأَلْبَابُ",
          "sadr": "قَدْ أَفْزَعَتْ مِنَّا الْقُلُوبُ صَرَاخَةٌ",
          "adj": "وَتَدَهَّشَتْ فِي دَوْيِهَا الْأَلْبَابُ"
        },
        {
          "ar": "كَالرَّعْدِ فِي هَيَجَانِهَا كَالْمَاءِ فِي سَرَيَانِهَا كَالْبَرْقِ يَا وَهَّابُ",
          "sadr": "كَالرَّعْدِ فِي هَيَجَانِهَا كَالْمَاءِ فِي",
          "adj": "سَرَيَانِهَا كَالْبَرْقِ يَا وَهَّابُ"
        },
