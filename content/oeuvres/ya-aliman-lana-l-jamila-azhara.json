      "n": 1,
      "verses": [
        {
          "ar": "يَا عَالِمًا لَنَا الْجَمِيلَ أَظْهَرَا وَغَافِرًا لَنَا الْقَبِيحَ سَتَرَا",
          "sadr": "يَا عَالِمًا لَنَا الْجَمِيلَ أَظْهَرَا",
          "adj": "وَغَافِرًا لَنَا الْقَبِيحَ سَتَرَا"
        },
        {
          "ar": "وَلَمْ يُؤَاخِذَانْ لَنَا الْجَرِيرَةْ لَمْ يَهْتِكِ السِّتْرَ وَلِي السَّرِيَرةْ",
          "sadr": "وَلَمْ يُؤَاخِذَانْ لَنَا الْجَرِيرَةْ",
          "adj": "لَمْ يَهْتِكِ السِّتْرَ وَلِي السَّرِيَرةْ"
        },
        {
          "ar": "وَيَا عَظِيمَ الْعَفْوِ لِلْأَثِيمِ يَا حَسَنَ التَّجَاوُزِ الْعَمِيمِ",
          "sadr": "وَيَا عَظِيمَ الْعَفْوِ لِلْأَثِيمِ",
          "adj": "يَا حَسَنَ التَّجَاوُزِ الْعَمِيمِ"
        },
        {
          "ar": "يَا وَاسِعَ الْمَغْفِرَةِ الْعَمِيمَةْ يَا بَاسِطَ الْيَدَيْنِ يَا ذَا الرَّحْمةْ",
          "sadr": "يَا وَاسِعَ الْمَغْفِرَةِ الْعَمِيمَةْ",
          "adj": "يَا بَاسِطَ الْيَدَيْنِ يَا ذَا الرَّحْمةْ"
        },
        {
          "ar": "يَا سَامِعاً بِكُلِّ نَجْوَى مُنْتَهَى بِكُلِّ شَكْوَى وَلَهُ مَا يُشْتَهَى",
          "sadr": "يَا سَامِعاً بِكُلِّ نَجْوَى مُنْتَهَى",
          "adj": "بِكُلِّ شَكْوَى وَلَهُ مَا يُشْتَهَى"
        },
        {
          "ar": "وَيَا كَرِيمَ الصَّفْحِ يَا حَلِيمَا وَيَا عَظِيمَ الْمَنِّ يَا رَحِيمَا",
          "sadr": "وَيَا كَرِيمَ الصَّفْحِ يَا حَلِيمَا",
          "adj": "وَيَا عَظِيمَ الْمَنِّ يَا رَحِيمَا"
        },
        {
          "ar": "وَيَا مُقِيلَ الْعَثَراتِ هَفَوَاتْ مُبْتَدِئاً بِنِعَمٍ وَمِنْ هِبَاتْ",
          "sadr": "وَيَا مُقِيلَ الْعَثَراتِ هَفَوَاتْ",
          "adj": "مُبْتَدِئاً بِنِعَمٍ وَمِنْ هِبَاتْ"
        },
        {
          "ar": "بِالفَضْلِ وَالْإِحْسَانِ رَبِّي فَعَلَا مِنْ قَبْلُ بِاسْتِحْقَاقِهَا جَلَّ عَلَا",
          "sadr": "بِالفَضْلِ وَالْإِحْسَانِ رَبِّي فَعَلَا",
          "adj": "مِنْ قَبْلُ بِاسْتِحْقَاقِهَا جَلَّ عَلَا"
        },
        {
          "ar": "يَا رَبِّ سَيِّدِي وَيَا مَوْلَايَا غَايَةَ رَغْبَتِي أَطِبْ مَحْيَايَا",
          "sadr": "يَا رَبِّ سَيِّدِي وَيَا مَوْلَايَا",
          "adj": "غَايَةَ رَغْبَتِي أَطِبْ مَحْيَايَا"
        },
        {
          "ar": "أَسْأَلُكَ اللَّهُمَّ يَا رَحْمَانُ فَلاَ تُشَوِّهْ خِلْقَتِي مَنَّانُ",
          "sadr": "أَسْأَلُكَ اللَّهُمَّ يَا رَحْمَانُ",
          "adj": "فَلاَ تُشَوِّهْ خِلْقَتِي مَنَّانُ"
        },
        {
          "ar": "عَلَى بَلَا الدُّنْيَا عَذَابِ النَّارِ فَهبْ لَنَا نَجَاةَ تِلْكَ الدَّارِ",
          "sadr": "عَلَى بَلَا الدُّنْيَا عَذَابِ النَّارِ",
          "adj": "فَهبْ لَنَا نَجَاةَ تِلْكَ الدَّارِ"
        }
      ]
    }
