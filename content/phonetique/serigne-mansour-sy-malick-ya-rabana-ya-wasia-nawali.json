{
  "slug": "serigne-mansour-sy-malick-ya-rabana-ya-wasia-nawali",
  "convention": "v1",
  "verses": {
    "3938": "yā rabbanā yā wāsiʿa n-nawāli",
    "3939": "wakhayra madʿʿuwi wakhayra wal-",
    "3940": "ʾasbil ʿalā l-jamīʿi minnā ʿāfiyata",
    "3941": "tadūmu fī d-dārayni khayra ʿāfiyyati",
    "3942": "likulli ḍarri wasiqāmi shāfiyyata",
    "3943": "likulli sūʾi wabalāʾi kāfiyyata",
    "3944": "likulli ḍayri washurūri kāfiyyata",
    "3945": "likulli khayri wasurūri ṣāfiyyata",
    "3946": "fī d-dīni wan-nufūsi wal-ʾabdāni",
    "3947": "wal-māli wal-ʾazwāji wal-wildāni",
    "3948": "waṣ-ṣaḥbi wal-ʾikhwāni wa l-ʾahlīnā",
    "3949": "wakulli man lanā waman yalīnā",
    "3950": "wābsiṭ lanā l-ʾarzāqa fī l-ḥalāli",
    "3951": "bilā taʿʿasuri walā ʾikhlāli",
    "3952": "wazid liʾahli l-muṣṭafā l-karīmi",
    "3953": "ʿizzā watakrīmā ʿalā t-takrīmi",
    "3954": "yā rabbanā wāghfir liwālidīnā",
    "3955": "walishuyūkhinā l-mujāhidīnā",
    "3956": "lijumlahi l-ʾikhwāni wal-ʾaḥbābi",
    "3957": "wāftaḥ mina l-khayrāti kulla bābi",
    "3958": "wāghfir likulli man ʾilaynā ʾaḥsanā",
    "3959": "wajāzihim ʿannā jazāʾa ḥasanā"
